#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

display=${XRDP_VNC_DISPLAY:-:0}
auth=${XRDP_VNC_AUTH:-}
if [ -n "$auth" ] && [ ! -r "$auth" ]; then
    exit 0
fi
if [ -z "$auth" ] && [ "${XRDP_VNC_ALLOW_AUTH_DISCOVERY:-0}" = "1" ]; then
    auth=$(
        ps -eo args= |
        awk '/\/Xorg / {
            for (i = 1; i < NF; i++) {
                if ($i == "-auth") {
                    print $(i + 1)
                    exit
                }
            }
        }'
    )
fi
if [ -z "$auth" ] && [ "${XRDP_VNC_ALLOW_AUTH_DISCOVERY:-0}" = "1" ]; then
    for candidate in /run/sddm/xauth_* /run/user/*/xrdp-console.xauth; do
        if [ -r "$candidate" ]; then
            auth=$candidate
            break
        fi
    done
fi
if [ -n "$auth" ] && [ -r "$auth" ]; then
    DISPLAY="$display" XAUTHORITY="$auth" \
        /usr/bin/timeout 5 /usr/bin/x11vnc -quiet \
        -display "$display" -auth "$auth" -R refresh >/dev/null 2>&1 || true
fi
