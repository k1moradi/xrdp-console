#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
data_root="@CMAKE_INSTALL_DATADIR@"
helper_root="@CMAKE_INSTALL_LIBEXECDIR@"
case "$data_root" in
    /*) data_dir="$data_root/xrdp-vnc-bench" ;;
    *) data_dir="$script_dir/../$data_root/xrdp-vnc-bench" ;;
esac
case "$helper_root" in
    /*) helper_dir="$helper_root/xrdp-vnc-bench" ;;
    *) helper_dir="$script_dir/../$helper_root/xrdp-vnc-bench" ;;
esac

export XRDP_VNC_BENCH_HELPER_DIR="${XRDP_VNC_BENCH_HELPER_DIR:-$helper_dir}"
exec "${PYTHON:-python3}" "$data_dir/xrdp_vnc_bench.py" "$@"
