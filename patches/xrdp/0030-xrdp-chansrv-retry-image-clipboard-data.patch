@@ -0,0 +1,93 @@
+#ifndef CLIPBOARD_IMAGE_RETRY_POLICY_H
+#define CLIPBOARD_IMAGE_RETRY_POLICY_H
+
+#include <stdint.h>
+
+enum
+{
+    CLIPBOARD_IMAGE_MAX_ATTEMPTS = 2,
+    CLIPBOARD_IMAGE_RETRY_DELAY_MS = 50
+};
+
+struct clipboard_image_retry_policy
+{
+    uint64_t generation;
+    unsigned int attempt;
+};
+
+static inline uint64_t
+clipboard_image_retry_next_generation(uint64_t generation)
+{
+    return generation == UINT64_MAX ? 1U : generation + 1U;
+}
+
+static inline uint64_t
+clipboard_image_retry_begin(struct clipboard_image_retry_policy *policy)
+{
+    if (policy == 0)
+    {
+        return 0;
+    }
+    policy->generation =
+        clipboard_image_retry_next_generation(policy->generation);
+    policy->attempt = 1;
+    return policy->generation;
+}
+
+static inline int
+clipboard_image_retry_active(
+    const struct clipboard_image_retry_policy *policy)
+{
+    return policy != 0 && policy->attempt != 0;
+}
+
+static inline int
+clipboard_image_retry_matches(
+    const struct clipboard_image_retry_policy *policy,
+    uint64_t generation, unsigned int attempt)
+{
+    return clipboard_image_retry_active(policy) && generation != 0 &&
+           policy->generation == generation && attempt != 0 &&
+           policy->attempt == attempt;
+}
+
+static inline int
+clipboard_image_retry_can_retry(
+    const struct clipboard_image_retry_policy *policy)
+{
+    return clipboard_image_retry_active(policy) &&
+           policy->attempt < CLIPBOARD_IMAGE_MAX_ATTEMPTS;
+}
+
+static inline int
+clipboard_image_retry_advance(struct clipboard_image_retry_policy *policy)
+{
+    if (!clipboard_image_retry_can_retry(policy))
+    {
+        return 0;
+    }
+    ++policy->attempt;
+    return 1;
+}
+
+static inline void
+clipboard_image_retry_reset(struct clipboard_image_retry_policy *policy)
+{
+    if (policy != 0)
+    {
+        policy->attempt = 0;
+    }
+}
+
+static inline void
+clipboard_image_retry_cancel(struct clipboard_image_retry_policy *policy)
+{
+    if (policy != 0)
+    {
+        policy->generation =
+            clipboard_image_retry_next_generation(policy->generation);
+        policy->attempt = 0;
+    }
+}
+
+#endif /* CLIPBOARD_IMAGE_RETRY_POLICY_H */
