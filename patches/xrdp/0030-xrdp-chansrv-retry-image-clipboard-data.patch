 static void
+clipboard_finish_image_retry(void)
+{
+    clipboard_image_retry_reset(&g_image_retry.policy);
+    g_image_retry.format_id = -1;
+    g_image_retry.format_generation = 0;
+    g_image_retry.retry_timeout_pending = 0;
+}
+
+static void
+clipboard_fail_image_retry(const char *reason)
+{
+    if (!clipboard_image_retry_active(&g_image_retry.policy))
+    {
+        return;
+    }
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_CLIPBOARD_IMAGE event=retry-failed reason=%s "
+        "format_id=%d attempts=%u",
+        reason, g_image_retry.format_id, g_image_retry.policy.attempt);
+    clipboard_refuse_selection(&g_saved_selection_req_event);
+    clipboard_image_retry_cancel(&g_image_retry.policy);
+    g_image_retry.format_id = -1;
+    g_image_retry.format_generation = 0;
+    g_image_retry.retry_timeout_pending = 0;
+}
+
+static int
+clipboard_schedule_image_retry(void);
+
+static void
+clipboard_image_retry_timeout(void *data)
+{
+    struct clipboard_image_retry_timeout *timeout_context;
+    uint64_t generation;
+    unsigned int attempt;
+
+    timeout_context = (struct clipboard_image_retry_timeout *)data;
+    if (timeout_context == NULL)
+    {
+        return;
+    }
+    generation = timeout_context->generation;
+    attempt = timeout_context->attempt;
+    g_free(timeout_context);
+
+    if (!g_clip_up || g_wnd == 0 ||
+            !clipboard_image_retry_matches(&g_image_retry.policy,
+                                           generation, attempt))
+    {
+        return;
+    }
+    g_image_retry.retry_timeout_pending = 0;
+    if (g_image_retry.format_generation != g_clipboard_format_generation ||
+            g_clip_c2s.in_request != 0 ||
+            !clipboard_image_retry_advance(&g_image_retry.policy))
+    {
+        clipboard_fail_image_retry("retry-state-changed");
+        return;
+    }
+
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_CLIPBOARD_IMAGE event=retry format_id=%d attempt=%u",
+        g_image_retry.format_id, g_image_retry.policy.attempt);
+    if (clipboard_send_data_request(g_image_retry.format_id) != 0)
+    {
+        g_clip_c2s.in_request = 0;
+        clipboard_fail_image_retry("retry-send-failed");
+    }
+}
+
+static int
+clipboard_schedule_image_retry(void)
+{
+    struct clipboard_image_retry_timeout *timeout_context;
+
+    if (!clipboard_image_retry_active(&g_image_retry.policy) ||
+            g_image_retry.retry_timeout_pending ||
+            !clipboard_image_retry_can_retry(&g_image_retry.policy))
+    {
+        return 0;
+    }
+    timeout_context = g_new0(struct clipboard_image_retry_timeout, 1);
+    if (timeout_context == NULL)
+    {
+        return 0;
+    }
+    timeout_context->generation = g_image_retry.policy.generation;
+    timeout_context->attempt = g_image_retry.policy.attempt;
+    if (add_timeout(CLIPBOARD_IMAGE_RETRY_DELAY_MS,
+                    clipboard_image_retry_timeout, timeout_context) != 0)
+    {
+        g_free(timeout_context);
+        return 0;
+    }
+    g_image_retry.retry_timeout_pending = 1;
+    return 1;
+}
+
+static int
+clipboard_begin_image_data_request(int format_id)
+{
+    int rv;
+
+    if (format_id < 0 || g_clip_c2s.in_request != 0)
+    {
+        return 1;
+    }
+    clipboard_image_retry_cancel(&g_image_retry.policy);
+    clipboard_image_retry_begin(&g_image_retry.policy);
+    g_image_retry.format_id = format_id;
+    g_image_retry.format_generation = g_clipboard_format_generation;
+    g_image_retry.retry_timeout_pending = 0;
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_CLIPBOARD_IMAGE event=request format_id=%d target=%s "
+        "attempt=1",
+        format_id, get_atom_text(g_clip_c2s.type));
+    rv = clipboard_send_data_request(format_id);
+    if (rv != 0)
+    {
+        g_clip_c2s.in_request = 0;
+        clipboard_fail_image_retry("initial-send-failed");
+    }
+    return rv;
+}
+
+static void
+clipboard_cancel_pending_image_retry(const char *reason)
+{
+    if (!clipboard_image_retry_active(&g_image_retry.policy) ||
+            !g_image_retry.retry_timeout_pending)
+    {
+        return;
+    }
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_CLIPBOARD_IMAGE event=retry-cancelled reason=%s "
+        "format_id=%d",
+        reason, g_image_retry.format_id);
+    clipboard_refuse_selection(&g_saved_selection_req_event);
+    clipboard_image_retry_cancel(&g_image_retry.policy);
+    g_image_retry.format_id = -1;
+    g_image_retry.format_generation = 0;
+    g_image_retry.retry_timeout_pending = 0;
+}
