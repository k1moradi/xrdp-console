@@ -0,0 +1,376 @@
+/*
+ * Small, allocation-free helpers for the CLIPRDR image formats supported by
+ * chansrv. Kept separate so the format and DIB bounds can be unit tested.
+ */
+#ifndef XRDP_CLIPBOARD_IMAGE_FORMATS_H
+#define XRDP_CLIPBOARD_IMAGE_FORMATS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+enum xrdp_clipboard_image_format
+{
+    XRDP_CLIPBOARD_IMAGE_NONE = 0,
+    XRDP_CLIPBOARD_IMAGE_DIB = 1,
+    XRDP_CLIPBOARD_IMAGE_DIBV5 = 2,
+    XRDP_CLIPBOARD_IMAGE_PNG = 3
+};
+
+enum
+{
+    XRDP_CLIPBOARD_CF_DIB = 8,
+    XRDP_CLIPBOARD_CF_DIBV5 = 17,
+    XRDP_CLIPBOARD_FORMAT_PNG = 0xc0bd
+};
+
+static inline int
+xrdp_clipboard_ascii_equal_ignore_case(const char *left, const char *right)
+{
+    unsigned char a;
+    unsigned char b;
+
+    if (left == NULL || right == NULL)
+    {
+        return 0;
+    }
+
+    while (*left != '\0' && *right != '\0')
+    {
+        a = (unsigned char)*left++;
+        b = (unsigned char)*right++;
+        if (a >= 'A' && a <= 'Z')
+        {
+            a = (unsigned char)(a - 'A' + 'a');
+        }
+        if (b >= 'A' && b <= 'Z')
+        {
+            b = (unsigned char)(b - 'A' + 'a');
+        }
+        if (a != b)
+        {
+            return 0;
+        }
+    }
+
+    return *left == '\0' && *right == '\0';
+}
+
+static inline enum xrdp_clipboard_image_format
+xrdp_clipboard_image_format_from_announce(uint32_t format_id,
+        const char *format_name)
+{
+    if (format_id == XRDP_CLIPBOARD_CF_DIB)
+    {
+        return XRDP_CLIPBOARD_IMAGE_DIB;
+    }
+    if (format_id == XRDP_CLIPBOARD_CF_DIBV5)
+    {
+        return XRDP_CLIPBOARD_IMAGE_DIBV5;
+    }
+    if (format_id >= 0xc000 &&
+            (xrdp_clipboard_ascii_equal_ignore_case(format_name, "PNG") ||
+             xrdp_clipboard_ascii_equal_ignore_case(format_name, "image/png")))
+    {
+        return XRDP_CLIPBOARD_IMAGE_PNG;
+    }
+    return XRDP_CLIPBOARD_IMAGE_NONE;
+}
+
+static inline uint32_t
+xrdp_clipboard_read_u32le(const unsigned char *bytes)
+{
+    return (uint32_t)bytes[0] |
+           ((uint32_t)bytes[1] << 8) |
+           ((uint32_t)bytes[2] << 16) |
+           ((uint32_t)bytes[3] << 24);
+}
+
+/* Returns 0 and a BMP-file-relative pixel offset on valid DIB input. */
+static inline int
+xrdp_clipboard_dib_pixel_offset(const unsigned char *dib,
+                                size_t dib_bytes,
+                                size_t *bmp_pixel_offset)
+{
+    uint32_t header_bytes;
+    uint32_t bit_count;
+    uint32_t compression;
+    uint32_t colors_used;
+    size_t offset;
+    size_t palette_entries;
+
+    if (dib == NULL || bmp_pixel_offset == NULL || dib_bytes < 40)
+    {
+        return 1;
+    }
+
+    header_bytes = xrdp_clipboard_read_u32le(dib);
+    if (header_bytes < 40 || (size_t)header_bytes > dib_bytes)
+    {
+        return 1;
+    }
+
+    bit_count = (uint32_t)dib[14] | ((uint32_t)dib[15] << 8);
+    if (bit_count != 1 && bit_count != 2 && bit_count != 4 &&
+            bit_count != 8 && bit_count != 16 && bit_count != 24 &&
+            bit_count != 32)
+    {
+        return 1;
+    }
+    compression = xrdp_clipboard_read_u32le(dib + 16);
+    colors_used = xrdp_clipboard_read_u32le(dib + 32);
+    offset = (size_t)header_bytes;
+
+    if (header_bytes == 40 && compression == 3)
+    {
+        offset += 12; /* BI_BITFIELDS masks following BITMAPINFOHEADER */
+    }
+    else if (header_bytes == 40 && compression == 6)
+    {
+        offset += 16; /* BI_ALPHABITFIELDS masks */
+    }
+    if (offset > dib_bytes)
+    {
+        return 1;
+    }
+
+    if (colors_used != 0)
+    {
+        palette_entries = (size_t)colors_used;
+    }
+    else if (bit_count <= 8)
+    {
+        palette_entries = (size_t)1U << bit_count;
+    }
+    else
+    {
+        palette_entries = 0;
+    }
+
+    if (palette_entries > (dib_bytes - offset) / 4)
+    {
+        return 1;
+    }
+    offset += palette_entries * 4;
+    if (offset > dib_bytes || offset > UINT32_MAX - 14U)
+    {
+        return 1;
+    }
+
+    *bmp_pixel_offset = offset + 14;
+    return 0;
+}
+
+static inline int
+xrdp_clipboard_png_signature_valid(const unsigned char *data, size_t bytes)
+{
+    static const unsigned char signature[8] =
+    {
+        0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a
+    };
+    size_t index;
+
+    if (data == NULL || bytes < sizeof(signature))
+    {
+        return 0;
+    }
+    for (index = 0; index < sizeof(signature); ++index)
+    {
+        if (data[index] != signature[index])
+        {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static inline uint32_t
+xrdp_clipboard_read_u32be(const unsigned char *bytes)
+{
+    return ((uint32_t)bytes[0] << 24) |
+           ((uint32_t)bytes[1] << 16) |
+           ((uint32_t)bytes[2] << 8) |
+           (uint32_t)bytes[3];
+}
+
+static inline uint32_t
+xrdp_clipboard_png_crc32(const unsigned char *data, size_t bytes)
+{
+    static const uint32_t table[16] =
+    {
+        0x00000000U, 0x1db71064U, 0x3b6e20c8U, 0x26d930acU,
+        0x76dc4190U, 0x6b6b51f4U, 0x4db26158U, 0x5005713cU,
+        0xedb88320U, 0xf00f9344U, 0xd6d6a3e8U, 0xcb61b38cU,
+        0x9b64c2b0U, 0x86d3d2d4U, 0xa00ae278U, 0xbdbdf21cU
+    };
+    uint32_t crc = 0xffffffffU;
+    size_t index;
+
+    for (index = 0; index < bytes; ++index)
+    {
+        unsigned char value = data[index];
+        crc = table[(crc ^ value) & 0x0fU] ^ (crc >> 4);
+        crc = table[(crc ^ (value >> 4)) & 0x0fU] ^ (crc >> 4);
+    }
+    return crc ^ 0xffffffffU;
+}
+
+static inline int
+xrdp_clipboard_png_bit_depth_valid(unsigned char bit_depth,
+                                   unsigned char color_type)
+{
+    switch (color_type)
+    {
+        case 0:
+            return bit_depth == 1 || bit_depth == 2 || bit_depth == 4 ||
+                   bit_depth == 8 || bit_depth == 16;
+        case 2:
+            return bit_depth == 8 || bit_depth == 16;
+        case 3:
+            return bit_depth == 1 || bit_depth == 2 || bit_depth == 4 ||
+                   bit_depth == 8;
+        case 4:
+        case 6:
+            return bit_depth == 8 || bit_depth == 16;
+        default:
+            return 0;
+    }
+}
+
+/* Validate the complete PNG envelope without decoding DEFLATE image data. */
+static inline int
+xrdp_clipboard_png_valid(const unsigned char *data, size_t bytes,
+                         uint32_t *width, uint32_t *height)
+{
+    size_t offset;
+    int saw_ihdr = 0;
+    int saw_plte = 0;
+    int saw_idat = 0;
+    int idat_closed = 0;
+    unsigned char color_type = 0;
+    unsigned char bit_depth = 0;
+
+    if (!xrdp_clipboard_png_signature_valid(data, bytes))
+    {
+        return 0;
+    }
+    offset = 8;
+    while (offset < bytes)
+    {
+        uint32_t chunk_length;
+        size_t chunk_bytes;
+        const unsigned char *chunk_type;
+        const unsigned char *chunk_data;
+        uint32_t expected_crc;
+        int is_ihdr;
+        int is_plte;
+        int is_idat;
+        int is_iend;
+
+        if (bytes - offset < 12)
+        {
+            return 0;
+        }
+        chunk_length = xrdp_clipboard_read_u32be(data + offset);
+        chunk_bytes = (size_t)chunk_length;
+        if (chunk_bytes > bytes - offset - 12)
+        {
+            return 0;
+        }
+        chunk_type = data + offset + 4;
+        chunk_data = chunk_type + 4;
+        expected_crc = xrdp_clipboard_read_u32be(chunk_data + chunk_bytes);
+        if (xrdp_clipboard_png_crc32(chunk_type, 4 + chunk_bytes) !=
+                expected_crc)
+        {
+            return 0;
+        }
+
+        is_ihdr = chunk_type[0] == 'I' && chunk_type[1] == 'H' &&
+                  chunk_type[2] == 'D' && chunk_type[3] == 'R';
+        is_plte = chunk_type[0] == 'P' && chunk_type[1] == 'L' &&
+                  chunk_type[2] == 'T' && chunk_type[3] == 'E';
+        is_idat = chunk_type[0] == 'I' && chunk_type[1] == 'D' &&
+                  chunk_type[2] == 'A' && chunk_type[3] == 'T';
+        is_iend = chunk_type[0] == 'I' && chunk_type[1] == 'E' &&
+                  chunk_type[2] == 'N' && chunk_type[3] == 'D';
+
+        if (!saw_ihdr)
+        {
+            uint32_t png_width;
+            uint32_t png_height;
+            if (!is_ihdr || chunk_bytes != 13)
+            {
+                return 0;
+            }
+            png_width = xrdp_clipboard_read_u32be(chunk_data);
+            png_height = xrdp_clipboard_read_u32be(chunk_data + 4);
+            bit_depth = chunk_data[8];
+            color_type = chunk_data[9];
+            if (png_width == 0 || png_height == 0 ||
+                    !xrdp_clipboard_png_bit_depth_valid(bit_depth,
+                                                       color_type) ||
+                    chunk_data[10] != 0 || chunk_data[11] != 0 ||
+                    chunk_data[12] > 1)
+            {
+                return 0;
+            }
+            if (width != NULL)
+            {
+                *width = png_width;
+            }
+            if (height != NULL)
+            {
+                *height = png_height;
+            }
+            saw_ihdr = 1;
+        }
+        else if (is_ihdr)
+        {
+            return 0;
+        }
+        else if (is_idat)
+        {
+            if (idat_closed || (color_type == 3 && !saw_plte))
+            {
+                return 0;
+            }
+            saw_idat = 1;
+        }
+        else
+        {
+            if (saw_idat)
+            {
+                idat_closed = 1;
+            }
+            if (is_iend)
+            {
+                return chunk_bytes == 0 && saw_idat &&
+                       offset + 12 == bytes;
+            }
+            if (is_plte)
+            {
+                size_t palette_entries = chunk_bytes / 3;
+                if (saw_plte || saw_idat ||
+                        (color_type != 2 && color_type != 3 &&
+                         color_type != 6) ||
+                        chunk_bytes == 0 || (chunk_bytes % 3) != 0 ||
+                        palette_entries > 256 ||
+                        (color_type == 3 &&
+                         palette_entries > ((size_t)1U << bit_depth)))
+                {
+                    return 0;
+                }
+                saw_plte = 1;
+            }
+            else if ((chunk_type[0] & 0x20U) == 0)
+            {
+                /* Unknown critical chunks require decoder support. */
+                return 0;
+            }
+        }
+        offset += 12 + chunk_bytes;
+    }
+    return 0;
+}
+
+#endif /* XRDP_CLIPBOARD_IMAGE_FORMATS_H */
