+static void
+test_clipboard_image_format_negotiation(void **state)
+{
+    UNUSED(state);
+
+    assert_int_equal(XRDP_CLIPBOARD_IMAGE_DIB,
+                     xrdp_clipboard_image_format_from_announce(
+                         XRDP_CLIPBOARD_CF_DIB, ""));
+    assert_int_equal(XRDP_CLIPBOARD_IMAGE_DIBV5,
+                     xrdp_clipboard_image_format_from_announce(
+                         XRDP_CLIPBOARD_CF_DIBV5, ""));
+    assert_int_equal(XRDP_CLIPBOARD_IMAGE_PNG,
+                     xrdp_clipboard_image_format_from_announce(
+                         XRDP_CLIPBOARD_FORMAT_PNG, "PNG"));
+    assert_int_equal(XRDP_CLIPBOARD_IMAGE_PNG,
+                     xrdp_clipboard_image_format_from_announce(
+                         0xc123, "image/PNG"));
+    assert_int_equal(XRDP_CLIPBOARD_IMAGE_NONE,
+                     xrdp_clipboard_image_format_from_announce(
+                         0x1234, "PNG"));
+    assert_int_equal(XRDP_CLIPBOARD_IMAGE_NONE,
+                     xrdp_clipboard_image_format_from_announce(
+                         0xc123, "JPEG"));
+}
+
+static void
+test_clipboard_dib_bounds_and_bmp_offsets(void **state)
+{
+    unsigned char dib[160];
+    size_t pixel_offset;
+
+    UNUSED(state);
+    g_memset(dib, 0, sizeof(dib));
+
+    /* BITMAPINFOHEADER with 24-bpp pixels starts at BMP byte 54. */
+    dib[0] = 40;
+    dib[14] = 24;
+    assert_int_equal(0, xrdp_clipboard_dib_pixel_offset(
+                            dib, 40, &pixel_offset));
+    assert_int_equal(54, pixel_offset);
+
+    /* BITMAPV5HEADER includes its channel masks in the header itself. */
+    dib[0] = 124;
+    dib[14] = 32;
+    assert_int_equal(0, xrdp_clipboard_dib_pixel_offset(
+                            dib, 124, &pixel_offset));
+    assert_int_equal(138, pixel_offset);
+
+    /* Indexed DIBs include their color table before the pixel array. */
+    dib[0] = 40;
+    dib[14] = 8;
+    dib[32] = 16;
+    assert_int_equal(0, xrdp_clipboard_dib_pixel_offset(
+                            dib, 104, &pixel_offset));
+    assert_int_equal(118, pixel_offset);
+
+    /* BITFIELDS masks follow a 40-byte info header. */
+    dib[14] = 24;
+    dib[16] = 3;
+    dib[32] = 0;
+    assert_int_equal(0, xrdp_clipboard_dib_pixel_offset(
+                            dib, 52, &pixel_offset));
+    assert_int_equal(66, pixel_offset);
+
+    assert_int_not_equal(0, xrdp_clipboard_dib_pixel_offset(
+                                dib, 39, &pixel_offset));
+    dib[0] = 124;
+    assert_int_not_equal(0, xrdp_clipboard_dib_pixel_offset(
+                                dib, 123, &pixel_offset));
+    dib[0] = 40;
+    dib[14] = 3; /* invalid bit depth */
+    assert_int_not_equal(0, xrdp_clipboard_dib_pixel_offset(
+                                dib, 40, &pixel_offset));
+}
