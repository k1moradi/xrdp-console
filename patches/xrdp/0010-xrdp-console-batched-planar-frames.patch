+static struct xrdp_region *
+xrdp_mm_copy_region(struct xrdp_wm *wm, struct xrdp_region *source)
+{
+    struct xrdp_region *copy;
+    struct xrdp_rect rect;
+    int index = 0;
+
+    copy = xrdp_region_create(wm);
+    if (copy == NULL)
+    {
+        return NULL;
+    }
+    while (xrdp_region_get_rect(source, index, &rect) == 0)
+    {
+        if (xrdp_region_add_rect(copy, &rect) != 0)
+        {
+            xrdp_region_delete(copy);
+            return NULL;
+        }
+        ++index;
+    }
+    return copy;
+}
+
+static int
+xrdp_mm_restore_console_dirty_region(struct xrdp_mm *self,
+                                     struct xrdp_region *snapshot)
+{
+    struct xrdp_rect rect;
+    int index = 0;
+    int rv = 0;
+
+    if (self->wm->screen_dirty_region == NULL)
+    {
+        self->wm->screen_dirty_region = xrdp_region_create(self->wm);
+    }
+    if (self->wm->screen_dirty_region == NULL)
+    {
+        return 1;
+    }
+    while (xrdp_region_get_rect(snapshot, index, &rect) == 0)
+    {
+        if (xrdp_region_add_rect(self->wm->screen_dirty_region, &rect) != 0)
+        {
+            rv = 1;
+        }
+        ++index;
+    }
+    return rv;
+}
+
+static int
+xrdp_mm_draw_dirty_console(struct xrdp_mm *self)
+{
+    struct xrdp_region *snapshot;
+    struct xrdp_region *monitor_region;
+    struct xrdp_rect monitor_rect;
+    struct monitor_info *monitor;
+    int monitor_count;
+    int monitor_index;
+    int frame_id;
+    int rv = 0;
+    int end_rv;
+
+    if (self->wm->screen_dirty_region == NULL ||
+            !xrdp_region_not_empty(self->wm->screen_dirty_region))
+    {
+        return 0;
+    }
+
+    snapshot = xrdp_mm_copy_region(self->wm,
+                                   self->wm->screen_dirty_region);
+    if (snapshot == NULL)
+    {
+        return 1;
+    }
+    if (xrdp_mm_console_planar_scratch(self) == NULL)
+    {
+        xrdp_region_delete(snapshot);
+        return 1;
+    }
+
+    if (self->wm->console_gfx_frame_id == INT_MAX)
+    {
+        self->wm->console_gfx_frame_id = 0;
+    }
+    frame_id = ++self->wm->console_gfx_frame_id;
+    if (xrdp_egfx_send_frame_start(self->egfx, frame_id, 0) != 0)
+    {
+        xrdp_region_delete(snapshot);
+        return 1;
+    }
+
+    self->console_planar_frame_open = 1;
+    self->console_planar_frame_id = frame_id;
+    self->console_planar_pixels_sent = 0;
+    self->console_planar_rectangles_sent = 0;
+    self->console_planar_tiles_sent = 0;
+
+    monitor_count = self->wm->client_info->display_sizes.monitorCount;
+    if (monitor_count < 1)
+    {
+        rv = xrdp_mm_egfx_send_planar_region(
+                 self, self->wm->screen, self->wm->screen_dirty_region,
+                 self->egfx->surface_id, 0, 0);
+    }
+    else
+    {
+        for (monitor_index = 0; monitor_index < monitor_count;
+             ++monitor_index)
+        {
+            monitor_region = xrdp_mm_copy_region(
+                                 self->wm, self->wm->screen_dirty_region);
+            if (monitor_region == NULL)
+            {
+                rv = 1;
+                break;
+            }
+            monitor = self->wm->client_info->display_sizes.minfo_wm +
+                      monitor_index;
+            monitor_rect.left = monitor->left;
+            monitor_rect.top = monitor->top;
+            monitor_rect.right = monitor->right + 1;
+            monitor_rect.bottom = monitor->bottom + 1;
+            if (xrdp_region_intersect_rect(monitor_region,
+                                           &monitor_rect) != 0)
+            {
+                rv = 1;
+            }
+            else
+            {
+                rv = xrdp_mm_egfx_send_planar_region(
+                         self, self->wm->screen, monitor_region,
+                         monitor_index, monitor->left, monitor->top);
+            }
+            xrdp_region_delete(monitor_region);
+            if (rv != 0 || self->console_planar_pixels_sent >=
+                    XRDP_CONSOLE_GFX_MAXIMUM_PIXELS_PER_FLUSH ||
+                    self->console_planar_rectangles_sent >=
+                    XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH)
+            {
+                break;
+            }
+        }
+    }
+
+    self->console_planar_frame_open = 0;
+    end_rv = xrdp_egfx_send_frame_end(self->egfx, frame_id);
+    if (end_rv != 0)
+    {
+        if (xrdp_mm_restore_console_dirty_region(self, snapshot) != 0)
+        {
+            LOG(LOG_LEVEL_ERROR,
+                "xrdp_mm_draw_dirty_console: failed to restore all dirty "
+                "rectangles after GFX frame failure");
+        }
+        rv = 1;
+    }
+
+    if (self->console_planar_batch_log_count == 0)
+    {
+        LOG(LOG_LEVEL_INFO, "XRDP_CONSOLE_GFX_PLANAR_BATCH_V1 enabled");
+    }
+    if (self->console_planar_batch_log_count < 64)
+    {
+        LOG(LOG_LEVEL_DEBUG,
+            "XRDP_CONSOLE_GFX_PLANAR_BATCH_V1 frame=%d starts=1 ends=%d "
+            "rects=%d tiles=%d pixels=%d pending=%d",
+            frame_id, end_rv == 0, self->console_planar_rectangles_sent,
+            self->console_planar_tiles_sent,
+            self->console_planar_pixels_sent,
+            xrdp_region_not_empty(self->wm->screen_dirty_region));
+    }
+    ++self->console_planar_batch_log_count;
+    xrdp_region_delete(snapshot);
+    return rv;
+}
