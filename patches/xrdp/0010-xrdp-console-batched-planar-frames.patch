+/* Return whether a dirty rectangle intersects any active display surface. */
+static int
+xrdp_mm_console_rect_intersects_active_display(
+    const struct xrdp_mm *self, const struct xrdp_rect *rect)
+{
+    struct monitor_info *monitor;
+    struct xrdp_rect screen_rect;
+    int monitor_count;
+    int monitor_index;
+
+    if (self == NULL || self->wm == NULL || self->wm->screen == NULL ||
+            self->wm->client_info == NULL || rect == NULL)
+    {
+        return 0;
+    }
+
+    monitor_count = self->wm->client_info->display_sizes.monitorCount;
+    if (monitor_count < 1)
+    {
+        screen_rect.left = 0;
+        screen_rect.top = 0;
+        screen_rect.right = self->wm->screen->width;
+        screen_rect.bottom = self->wm->screen->height;
+        return rect->left < screen_rect.right &&
+               screen_rect.left < rect->right &&
+               rect->top < screen_rect.bottom &&
+               screen_rect.top < rect->bottom;
+    }
+
+    for (monitor_index = 0; monitor_index < monitor_count; ++monitor_index)
+    {
+        monitor = self->wm->client_info->display_sizes.minfo_wm +
+                  monitor_index;
+        if (rect->left < monitor->right + 1 &&
+                monitor->left < rect->right &&
+                rect->top < monitor->bottom + 1 &&
+                monitor->top < rect->bottom)
+        {
+            return 1;
+        }
+    }
+
+    return 0;
+}
