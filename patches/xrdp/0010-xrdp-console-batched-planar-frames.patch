+static struct xrdp_console_planar_scratch *
+xrdp_mm_console_planar_scratch(struct xrdp_mm *self)
+{
+    struct xrdp_console_planar_scratch *scratch;
+
+    scratch = self->console_planar_scratch;
+    if (scratch == NULL)
+    {
+        scratch = (struct xrdp_console_planar_scratch *)
+                  g_malloc(sizeof(*scratch), 1);
+        if (scratch == NULL)
+        {
+            return NULL;
+        }
+        scratch->pixels = g_new(char, GFX_PLANAR_BYTES);
+        make_stream(scratch->compressed);
+        make_stream(scratch->temporary);
+        if (scratch->pixels == NULL || scratch->compressed == NULL ||
+                scratch->temporary == NULL)
+        {
+            g_free(scratch->pixels);
+            free_stream(scratch->compressed);
+            free_stream(scratch->temporary);
+            g_free(scratch);
+            return NULL;
+        }
+        init_stream(scratch->compressed, GFX_PLANAR_BYTES);
+        init_stream(scratch->temporary, GFX_PLANAR_BYTES);
+        self->console_planar_scratch = scratch;
+    }
+
+    return scratch;
+}
