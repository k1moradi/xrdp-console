+void
+xrdp_mm_console_record_gfx_acknowledgement(
+    struct xrdp_console_gfx_ack_telemetry *telemetry,
+    uint32_t queue_depth, int frame_id, int frames_decoded)
+{
+    if (telemetry->acknowledgement_count != UINT64_MAX)
+    {
+        ++telemetry->acknowledgement_count;
+    }
+    telemetry->latest_frame_id = frame_id;
+    telemetry->latest_frames_decoded = frames_decoded;
+
+    if (queue_depth == XR_SUSPEND_FRAME_ACKNOWLEDGEMENT)
+    {
+        if (telemetry->suspension_count != UINT64_MAX)
+        {
+            ++telemetry->suspension_count;
+        }
+        telemetry->acknowledgements_suspended = 1;
+        return;
+    }
+
+    telemetry->acknowledgements_suspended = 0;
+    telemetry->latest_queue_depth = queue_depth;
+    if (queue_depth > telemetry->maximum_queue_depth)
+    {
+        telemetry->maximum_queue_depth = queue_depth;
+    }
+}
 
