+static void
+test_console_gfx_acknowledgement_telemetry_tracks_queue_depth(void **state)
+{
+    struct xrdp_console_gfx_ack_telemetry telemetry = {0};
+    UNUSED(state);
+
+    xrdp_mm_console_record_gfx_acknowledgement(&telemetry, 0U, 10, 8);
+    assert_int_equal(1, telemetry.acknowledgement_count);
+    assert_int_equal(0, telemetry.latest_queue_depth);
+    assert_int_equal(0, telemetry.maximum_queue_depth);
+    assert_int_equal(10, telemetry.latest_frame_id);
+    assert_int_equal(8, telemetry.latest_frames_decoded);
+    assert_int_equal(0, telemetry.acknowledgements_suspended);
+
+    xrdp_mm_console_record_gfx_acknowledgement(&telemetry, 7U, 11, 9);
+    assert_int_equal(2, telemetry.acknowledgement_count);
+    assert_int_equal(7, telemetry.latest_queue_depth);
+    assert_int_equal(7, telemetry.maximum_queue_depth);
+
+    xrdp_mm_console_record_gfx_acknowledgement(&telemetry, 3U, 12, 10);
+    assert_int_equal(3, telemetry.acknowledgement_count);
+    assert_int_equal(3, telemetry.latest_queue_depth);
+    assert_int_equal(7, telemetry.maximum_queue_depth);
+    assert_int_equal(12, telemetry.latest_frame_id);
+    assert_int_equal(10, telemetry.latest_frames_decoded);
+
+    /* Preserve the most recently observed ACK even if frame IDs go backward. */
+    xrdp_mm_console_record_gfx_acknowledgement(&telemetry, 2U, 8, 6);
+    assert_int_equal(4, telemetry.acknowledgement_count);
+    assert_int_equal(8, telemetry.latest_frame_id);
+    assert_int_equal(6, telemetry.latest_frames_decoded);
+
+    /* Keep signed protocol values as observed instead of normalizing them. */
+    xrdp_mm_console_record_gfx_acknowledgement(&telemetry, 1U, -1, -1);
+    assert_int_equal(-1, telemetry.latest_frame_id);
+    assert_int_equal(-1, telemetry.latest_frames_decoded);
+}
+
+static void
+test_console_gfx_acknowledgement_telemetry_tracks_suspend_and_resume(
+    void **state)
+{
+    struct xrdp_console_gfx_ack_telemetry telemetry = {0};
+    UNUSED(state);
+
+    xrdp_mm_console_record_gfx_acknowledgement(&telemetry, 4U, 20, 18);
+    xrdp_mm_console_record_gfx_acknowledgement(
+        &telemetry, XR_SUSPEND_FRAME_ACKNOWLEDGEMENT, 21, 19);
+    assert_int_equal(2, telemetry.acknowledgement_count);
+    assert_int_equal(1, telemetry.suspension_count);
+    assert_int_equal(1, telemetry.acknowledgements_suspended);
+    assert_int_equal(4, telemetry.latest_queue_depth);
+    assert_int_equal(4, telemetry.maximum_queue_depth);
+    assert_int_equal(21, telemetry.latest_frame_id);
+    assert_int_equal(19, telemetry.latest_frames_decoded);
+
+    xrdp_mm_console_record_gfx_acknowledgement(
+        &telemetry, XR_SUSPEND_FRAME_ACKNOWLEDGEMENT, 22, 20);
+    assert_int_equal(3, telemetry.acknowledgement_count);
+    assert_int_equal(2, telemetry.suspension_count);
+    assert_int_equal(1, telemetry.acknowledgements_suspended);
+    assert_int_equal(4, telemetry.latest_queue_depth);
+
+    xrdp_mm_console_record_gfx_acknowledgement(&telemetry, 1U, 23, 21);
+    assert_int_equal(4, telemetry.acknowledgement_count);
+    assert_int_equal(2, telemetry.suspension_count);
+    assert_int_equal(0, telemetry.acknowledgements_suspended);
+    assert_int_equal(1, telemetry.latest_queue_depth);
+    assert_int_equal(4, telemetry.maximum_queue_depth);
+    assert_int_equal(23, telemetry.latest_frame_id);
+    assert_int_equal(21, telemetry.latest_frames_decoded);
+
+    telemetry.acknowledgement_count = UINT64_MAX;
+    telemetry.suspension_count = UINT64_MAX;
+    xrdp_mm_console_record_gfx_acknowledgement(
+        &telemetry, XR_SUSPEND_FRAME_ACKNOWLEDGEMENT, -1, -1);
+    assert_true(telemetry.acknowledgement_count == UINT64_MAX);
+    assert_true(telemetry.suspension_count == UINT64_MAX);
+}
