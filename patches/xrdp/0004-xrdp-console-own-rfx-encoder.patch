+    if (self->code == XRDP_CONSOLE_SESSION_CODE && self->encoder != NULL)
+    {
+        LOG(LOG_LEVEL_INFO,
+            "xrdp-console: disabling xrdp generic encoder thread");
+        xrdp_encoder_delete(self->encoder);
+        self->encoder = NULL;
+    }
