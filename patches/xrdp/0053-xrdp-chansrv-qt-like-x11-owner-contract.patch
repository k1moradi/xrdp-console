+
+/*
+ * Match Qt's XCB clipboard sizing policy: use the largest request size the
+ * X server actually negotiated, including BIG-REQUESTS when available.
+ * XChangeProperty request overhead is six 32-bit units (24 bytes).
+ */
+static int
+clipboard_x11_max_property_bytes(void)
+{
+    long request_units;
+
+    request_units = XExtendedMaxRequestSize(g_display);
+    if (request_units <= 0)
+    {
+        request_units = XMaxRequestSize(g_display);
+    }
+    if (request_units <= 6)
+    {
+        return 1;
+    }
+    if (request_units > ((long)INT_MAX + 24L) / 4L)
+    {
+        return INT_MAX;
+    }
+    return (int)(request_units * 4L - 24L);
+}
