+
+/*
+ * Use X11's negotiated normal request limit, but do not send giant
+ * BIG-REQUESTS-sized clipboard properties.  A single ~16 MiB chunk held
+ * the requestor for too long and broke otherwise valid multi-chunk INCR
+ * transfers.  Bound each chunk to 256 KiB for fair, incremental progress.
+ */
+static int
+clipboard_x11_max_property_bytes(void)
+{
+    long request_units = XMaxRequestSize(g_display);
+
+    if (request_units <= 6)
+    {
+        return 1;
+    }
+    request_units -= 6; /* XChangeProperty header, in 32-bit units */
+    if (request_units > (256L * 1024L / 4L))
+    {
+        request_units = 256L * 1024L / 4L;
+    }
+    return (int)(request_units * 4L);
+}
+
+static int
+clipboard_request_predates_selection(Time request_time, Time owner_time)
+{
+    if (request_time == CurrentTime || owner_time == CurrentTime)
+    {
+        return 0;
+    }
+    /* X11 times are 32-bit sequence numbers, including wraparound. */
+    return (uint32_t)(request_time - owner_time) >= 0x80000000U;
+}
