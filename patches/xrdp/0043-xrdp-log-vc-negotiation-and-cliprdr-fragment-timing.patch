+                clip_msg_flags = xrdp_channel_uint16_le(clip_header + 2);
+                clip_data_len = xrdp_channel_uint32_le(clip_header + 4);
+                LOG(LOG_LEVEL_INFO,
+                    "XRDP_CONSOLE_RDP_VC event=cliprdr-first-fragment "
