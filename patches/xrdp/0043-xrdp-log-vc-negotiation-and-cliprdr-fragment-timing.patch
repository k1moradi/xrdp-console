+/* SPDX-License-Identifier: Apache-2.0 */
+
+#ifndef XRDP_RDP_VC_DIAGNOSTICS_H
+#define XRDP_RDP_VC_DIAGNOSTICS_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct xrdp_vc_diagnostic_caps
+{
+    uint32_t flags;
+    uint32_t chunk_size;
+    int chunk_size_present;
+};
+
+struct xrdp_cliprdr_diagnostic_header
+{
+    uint16_t message_type;
+    uint16_t message_flags;
+    uint32_t data_length;
+};
+
+/* The VC capability payload is either flags-only (4 bytes), or includes
+ * VCChunkSize (8 bytes). Lengths 5-7 are truncated optional fields. */
+static inline int
+xrdp_vc_diagnostic_decode_caps(const uint8_t *data, size_t bytes,
+                               struct xrdp_vc_diagnostic_caps *caps)
+{
+    if (data == NULL || caps == NULL ||
+            (bytes < 4) || (bytes > 4 && bytes < 8))
+    {
+        return 0;
+    }
+
+    caps->flags = ((uint32_t)data[0]) |
+                  ((uint32_t)data[1] << 8) |
+                  ((uint32_t)data[2] << 16) |
+                  ((uint32_t)data[3] << 24);
+    caps->chunk_size_present = bytes >= 8;
+    caps->chunk_size = caps->chunk_size_present ?
+        (((uint32_t)data[4]) |
+         ((uint32_t)data[5] << 8) |
+         ((uint32_t)data[6] << 16) |
+         ((uint32_t)data[7] << 24)) : 0;
+    return 1;
+}
+
+/* A CLIPRDR common header is exactly 8 bytes; bytes after it may be only the
+ * first fragment of the PDU, so data_length is not checked against bytes. */
+static inline int
+xrdp_vc_diagnostic_decode_cliprdr_header(
+    const uint8_t *data, size_t bytes,
+    struct xrdp_cliprdr_diagnostic_header *header)
+{
+    if (data == NULL || header == NULL || bytes < 8)
+    {
+        return 0;
+    }
+
+    header->message_type = (uint16_t)(((uint16_t)data[0]) |
+                                      ((uint16_t)data[1] << 8));
+    header->message_flags = (uint16_t)(((uint16_t)data[2]) |
+                                       ((uint16_t)data[3] << 8));
+    header->data_length = ((uint32_t)data[4]) |
+                          ((uint32_t)data[5] << 8) |
+                          ((uint32_t)data[6] << 16) |
+                          ((uint32_t)data[7] << 24);
+    return 1;
+}
+
+#endif /* XRDP_RDP_VC_DIAGNOSTICS_H */
