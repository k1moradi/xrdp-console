+                "compression_type=%u",
+                length, fragment_bytes, flags,
+                (flags & XR_CHANNEL_PACKET_COMPRESSED) != 0,
+                ((unsigned int)flags &
+                 XR_CHANNEL_PACKET_COMPR_TYPE_MASK) >> 16);
+        }
+    }
+
     rv = xrdp_channel_call_callback(self, s, channel_id, length, flags);
