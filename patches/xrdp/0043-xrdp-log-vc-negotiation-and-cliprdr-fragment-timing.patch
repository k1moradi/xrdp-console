From: xrdp-console contributors
Subject: [PATCH] xrdp: log virtual-channel negotiation and cliprdr fragment timing

Add diagnostics needed to audit the pinned xrdp static-virtual-channel
implementation against MS-RDPBCGR before enabling compression or changing
clipboard behavior.

This patch is intentionally observational:
- it does not advertise a Virtual Channel Capability Set;
- it does not compress or decompress channel data;
- it does not change MCS priority;
- it does not change virtual-channel chunking;
- it does not change clipboard ownership or delayed-rendering behavior.

The new XRDP_CONSOLE_RDP_VC markers record:
- client TS_VIRTUALCHANNEL_CAPABILITYSET flags / optional VCChunkSize;
- the server's current lack of a VC capability advertisement;
- Client Info bulk-compression request/type;
- static CHANNEL_DEF options;
- CLIPRDR first/last virtual-channel fragment timing and, where the first
  fragment is uncompressed and contains the CLIPRDR common header, its
  msgType/msgFlags/dataLen and payload bytes already present.

The intent is to measure request -> first CLIPRDR payload fragment -> final
fragment -> chansrv response processing without changing the protocol path.

--- a/common/ms-rdpbcgr.h
+++ b/common/ms-rdpbcgr.h
@@ -216,6 +216,11 @@
 #define CAPSTYPE_VIRTUALCHANNEL                 0x0014
 #define CAPSTYPE_VIRTUALCHANNEL_LEN             0x08
 
+/* Virtual Channel Capability Set: flags (2.2.7.1.10) */
+#define XR_VCCAPS_NO_COMPR                      0x00000000
+#define XR_VCCAPS_COMPR_SC                      0x00000001
+#define XR_VCCAPS_COMPR_CS_8K                   0x00000002
+
 #define CAPSTYPE_DRAWNINGRIDCACHE               0x0015
 #define CAPSTYPE_DRAWGDIPLUS                    0x0016
 #define CAPSTYPE_RAIL                           0x0017
@@ -274,6 +274,10 @@
 #define XR_CHANNEL_FLAG_FIRST          0x00000001
 #define XR_CHANNEL_FLAG_LAST           0x00000002
 #define XR_CHANNEL_FLAG_SHOW_PROTOCOL  0x00000010
+#define XR_CHANNEL_PACKET_COMPRESSED   0x00200000
+#define XR_CHANNEL_PACKET_AT_FRONT     0x00400000
+#define XR_CHANNEL_PACKET_FLUSHED      0x00800000
+#define XR_CHANNEL_PACKET_COMPR_TYPE_MASK 0x000F0000
 
 /* General Capability Set: osMajorType (2.2.7.1.1) */
 #define OSMAJORTYPE_UNSPECIFIED        0x0000
--- a/libxrdp/xrdp_caps.c
+++ b/libxrdp/xrdp_caps.c
@@ -124,4 +124,46 @@
 /*****************************************************************************/
+/*
+ * Observe [MS-RDPBCGR] TS_VIRTUALCHANNEL_CAPABILITYSET without changing
+ * negotiated behavior. The outer capability parser advances past any fields
+ * we do not consume.
+ */
+static int
+xrdp_caps_process_virtualchannel(struct xrdp_rdp *self, struct stream *s,
+                                 int len)
+{
+    int flags;
+    unsigned int vc_chunk_size = 0;
+    int vc_chunk_size_present = 0;
+
+    (void)self;
+
+    if (len < 4)
+    {
+        LOG(LOG_LEVEL_WARNING,
+            "XRDP_CONSOLE_RDP_VC event=client-vc-caps-malformed "
+            "payload_bytes=%d", len);
+        return 0;
+    }
+
+    in_uint32_le(s, flags);
+    if (len >= 8)
+    {
+        in_uint32_le(s, vc_chunk_size);
+        vc_chunk_size_present = 1;
+    }
+
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_RDP_VC event=client-vc-caps "
+        "flags=0x%8.8x compr_sc=%d compr_cs_8k=%d "
+        "vc_chunk_size_present=%d vc_chunk_size=%u",
+        flags,
+        (flags & XR_VCCAPS_COMPR_SC) != 0,
+        (flags & XR_VCCAPS_COMPR_CS_8K) != 0,
+        vc_chunk_size_present, vc_chunk_size);
+    return 0;
+}
+
+/*****************************************************************************/
 static int
 xrdp_caps_process_bitmap(struct xrdp_rdp *self, struct stream *s,
                          int len)
@@ -890,7 +890,11 @@
                 break;
             case CAPSTYPE_VIRTUALCHANNEL:
                 LOG_DEVEL(LOG_LEVEL_INFO, "Received [MS-RDPBCGR] TS_CONFIRM_ACTIVE_PDU - TS_CAPS_SET "
-                          "capabilitySetType = CAPSTYPE_VIRTUALCHANNEL - Ignored");
+                          "capabilitySetType = CAPSTYPE_VIRTUALCHANNEL");
+                if (xrdp_caps_process_virtualchannel(self, s, len) != 0)
+                {
+                    return 1;
+                }
                 break;
             case CAPSTYPE_DRAWNINGRIDCACHE:
                 LOG_DEVEL(LOG_LEVEL_INFO, "Received [MS-RDPBCGR] TS_CONFIRM_ACTIVE_PDU - TS_CAPS_SET "
@@ -1090,6 +1090,14 @@
     out_uint8s(s, 4);
     caps_ptr = s->p;
 
+    /*
+     * Phase-A audit marker. xrdp 0.10.6.1 currently emits no
+     * TS_VIRTUALCHANNEL_CAPABILITYSET here. Do not change that until the
+     * receive-side decompressor and negotiation state are implemented.
+     */
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_RDP_VC event=server-vc-caps advertised=0");
+
     /* Output share capability set */
     caps_count++;
     out_uint16_le(s, CAPSTYPE_SHARE);
