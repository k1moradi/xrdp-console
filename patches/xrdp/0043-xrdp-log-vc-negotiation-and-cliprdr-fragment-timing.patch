+                    "msg_type=%u msg_flags=0x%4.4x data_len=%u "
+                    "payload_bytes_in_fragment=%d",
+                    length, fragment_bytes, flags,
+                    clip_msg_type, clip_msg_flags, clip_data_len,
+                    fragment_bytes - 8);
+            }
+            else
+            {
+                LOG(LOG_LEVEL_INFO,
+                    "XRDP_CONSOLE_RDP_VC event=cliprdr-first-fragment "
+                    "direction=client-to-server total_len=%d "
+                    "fragment_bytes=%d flags=0x%8.8x compressed=%d "
+                    "compression_type=%u cliprdr_header_available=0",
+                    length, fragment_bytes, flags,
+                    (flags & XR_CHANNEL_PACKET_COMPRESSED) != 0,
+                    ((unsigned int)flags &
