 /*****************************************************************************/
+static int
+xrdp_channel_is_cliprdr(const struct mcs_channel_item *channel)
+{
+    return channel != NULL &&
+           g_strcasecmp(channel->name, CLIPRDR_SVC_CHANNEL_NAME) == 0;
+}
+
+/*****************************************************************************/
+static unsigned int
+xrdp_channel_uint16_le(const unsigned char *p)
+{
+    return ((unsigned int)p[0]) |
+           ((unsigned int)p[1] << 8);
+}
+
+/*****************************************************************************/
+static unsigned int
+xrdp_channel_uint32_le(const unsigned char *p)
+{
+    return ((unsigned int)p[0]) |
+           ((unsigned int)p[1] << 8) |
+           ((unsigned int)p[2] << 16) |
+           ((unsigned int)p[3] << 24);
+}
+
+/*****************************************************************************/
 struct xrdp_channel *
 xrdp_channel_create(struct xrdp_sec *owner, struct xrdp_mcs *mcs_layer)
 {
