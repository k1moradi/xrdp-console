 /*****************************************************************************/
+/*
+ * Observe [MS-RDPBCGR] TS_VIRTUALCHANNEL_CAPABILITYSET without changing
+ * negotiated behavior. The outer capability parser advances past any fields
+ * we do not consume.
+ */
+static int
+xrdp_caps_process_virtualchannel(struct xrdp_rdp *self, struct stream *s,
+                                 int len)
+{
+    struct xrdp_vc_diagnostic_caps caps;
+
+    (void)self;
+
+    if (len < 0 || !xrdp_vc_diagnostic_decode_caps(
+                (const uint8_t *)s->p, (size_t)len, &caps))
+    {
+        LOG(LOG_LEVEL_WARNING,
+            "XRDP_CONSOLE_RDP_VC event=client-vc-caps-malformed "
+            "payload_bytes=%d", len);
+        return 0;
+    }
+
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_RDP_VC event=client-vc-caps "
+        "flags=0x%8.8x compr_sc=%d compr_cs_8k=%d "
+        "vc_chunk_size_present=%d vc_chunk_size=%u",
+        caps.flags,
+        (caps.flags & XR_VCCAPS_COMPR_SC) != 0,
+        (caps.flags & XR_VCCAPS_COMPR_CS_8K) != 0,
+        caps.chunk_size_present, caps.chunk_size);
+    return 0;
+}
+
+/*****************************************************************************/
 static int
 xrdp_caps_process_bitmap(struct xrdp_rdp *self, struct stream *s,
                          int len)
