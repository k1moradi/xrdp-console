+START_TEST(test_xrdp_egfx_map_surface_scaled__wire_layout)
+{
+    struct xrdp_egfx_bulk *bulk = g_new0(struct xrdp_egfx_bulk, 1);
+    const int surface_id = 0x1234;
+    const int output_x = 0x01020304;
+    const int output_y = 0x11121314;
+    const int target_width = 1512;
+    const int target_height = 949;
+    int descriptor;
+    int compression_header;
+    int command_id;
+    int flags;
+    int pdu_length;
+    int encoded_surface_id;
+    int reserved;
+    int encoded_output_x;
+    int encoded_output_y;
+    int encoded_target_width;
+    int encoded_target_height;
+    struct stream *s = xrdp_egfx_map_surface_scaled(
+                           bulk, surface_id, output_x, output_y,
+                           target_width, target_height);
+
+    s->p = s->data;
+    in_uint8(s, descriptor);
+    in_uint8(s, compression_header);
+    in_uint16_le(s, command_id);
+    in_uint16_le(s, flags);
+    in_uint32_le(s, pdu_length);
+    in_uint16_le(s, encoded_surface_id);
+    in_uint16_le(s, reserved);
+    in_uint32_le(s, encoded_output_x);
+    in_uint32_le(s, encoded_output_y);
+    in_uint32_le(s, encoded_target_width);
+    in_uint32_le(s, encoded_target_height);
+
+    ck_assert_int_eq(0xE0, descriptor);
+    ck_assert_int_eq(0x04, compression_header);
+    ck_assert_int_eq(XR_RDPGFX_CMDID_MAPSURFACETOSCALEDOUTPUT, command_id);
+    ck_assert_int_eq(0, flags);
+    ck_assert_int_eq(28, pdu_length);
+    ck_assert_int_eq(surface_id, encoded_surface_id);
+    ck_assert_int_eq(0, reserved);
+    ck_assert_int_eq(output_x, encoded_output_x);
+    ck_assert_int_eq(output_y, encoded_output_y);
+    ck_assert_int_eq(target_width, encoded_target_width);
+    ck_assert_int_eq(target_height, encoded_target_height);
+    ck_assert_int_eq(0, (int) (s->end - s->p));
+
+    free_stream(s);
+    g_free(bulk);
+}
+END_TEST
