+/******************************************************************************/
+struct stream *
+xrdp_egfx_map_surface_scaled(struct xrdp_egfx_bulk *bulk, int surface_id,
+                             int x, int y, int target_width,
+                             int target_height)
+{
+    int bytes;
+    struct stream *s;
+
+    LOG(LOG_LEVEL_TRACE, "xrdp_egfx_map_surface_scaled:");
+    make_stream(s);
+    init_stream(s, 8192);
+    /* RDP_SEGMENTED_DATA */
+    out_uint8(s, 0xE0); /* descriptor = SINGLE */
+    /* RDP8_BULK_ENCODED_DATA */
+    out_uint8(s, PACKET_COMPR_TYPE_RDP8); /* header */
+    /* RDPGFX_HEADER */
+    out_uint16_le(s, XR_RDPGFX_CMDID_MAPSURFACETOSCALEDOUTPUT); /* cmdId */
+    out_uint16_le(s, 0); /* flags = 0 */
+    s_push_layer(s, iso_hdr, 4); /* pduLength, set later */
+    out_uint16_le(s, surface_id);
+    out_uint16_le(s, 0); /* reserved */
+    out_uint32_le(s, x);
+    out_uint32_le(s, y);
+    out_uint32_le(s, target_width);
+    out_uint32_le(s, target_height);
+    s_mark_end(s);
+    bytes = (int) ((s->end - s->iso_hdr) + 4);
+    s_pop_layer(s, iso_hdr);
+    out_uint32_le(s, bytes);
+    return s;
+}
+
+/******************************************************************************/
+int
+xrdp_egfx_send_map_surface_scaled(struct xrdp_egfx *egfx, int surface_id,
+                                  int x, int y, int target_width,
+                                  int target_height)
+{
+    int error;
+    struct stream *s;
+
+    LOG(LOG_LEVEL_TRACE, "xrdp_egfx_send_map_surface_scaled:");
+    s = xrdp_egfx_map_surface_scaled(egfx->bulk, surface_id, x, y,
+                                     target_width, target_height);
+    error = xrdp_egfx_send_s(egfx, s);
+    LOG(LOG_LEVEL_DEBUG,
+        "xrdp_egfx_send_map_surface_scaled: xrdp_egfx_send_s error %d",
+        error);
+    free_stream(s);
+    return error;
+}
+
