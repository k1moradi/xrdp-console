 /**************************************************************************//**
+ * Cache an unsolicited named-PNG response. This path has no X11 selection
+ * request and deliberately does not touch g_saved_selection_req_event.
+ */
+static int
+clipboard_process_png_prefetch_response(struct stream *s)
+{
+    int len;
+    const unsigned char *image_data;
+
+    len = (int)(s->end - s->p);
+    if (len < 1)
+    {
+        return 1;
+    }
+    image_data = (const unsigned char *)s->p;
+    if (!xrdp_clipboard_png_signature_valid(image_data, (size_t)len))
+    {
+        return 1;
+    }
+
+    g_free(g_clip_c2s.data);
+    g_clip_c2s.data = (char *)g_malloc((size_t)len, 0);
+    if (g_clip_c2s.data == NULL)
+    {
+        g_clip_c2s.total_bytes = 0;
+        g_clip_c2s.read_bytes_done = 0;
+        g_clip_c2s.converted = 0;
+        return 1;
+    }
+    g_memcpy(g_clip_c2s.data, s->p, (size_t)len);
+    g_clip_c2s.total_bytes = len;
+    g_clip_c2s.read_bytes_done = len;
+    g_clip_c2s.converted = 1;
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_CLIPBOARD_IMAGE event=png-prefetch-response "
+        "format_id=%d bytes=%d generation=%llu",
+        g_png_format_id, len,
+        (unsigned long long)g_image_prefetch_generation);
+    return 0;
+}
