@@ -3264,8 +3273,79 @@
         }
         atom_buf[atom_count] = 0;
         LOG_DEVEL(LOG_LEVEL_DEBUG, "  reporting %d formats", atom_count);
-        return clipboard_provide_selection(lxev, XA_ATOM, 32,
-                                           (char *)atom_buf, atom_count);
+        target_names[0] = '\0';
+        target_names_length = 0;
+        target_names_truncated = 0;
+        for (target_index = 0; target_index < atom_count; ++target_index)
+        {
+            /* Known atom IDs are reliable even when > 512; the legacy
+             * get_atom_text() helper refuses to resolve those IDs.
+             * No synchronous XGetAtomName() call is required here. */
+            target_atom = atom_buf[target_index];
+            target_name = "unresolved";
+            if (target_atom == g_targets_atom)
+            {
+                target_name = "TARGETS";
+            }
+            else if (target_atom == g_timestamp_atom)
+            {
+                target_name = "TIMESTAMP";
+            }
+            else if (target_atom == g_multiple_atom)
+            {
+                target_name = "MULTIPLE";
+            }
+            else if (target_atom == XA_STRING)
+            {
+                target_name = "STRING";
+            }
+            else if (target_atom == g_utf8_atom)
+            {
+                target_name = "UTF8_STRING";
+            }
+            else if (target_atom == g_image_png_atom)
+            {
+                target_name = "image/png";
+            }
+            else if (target_atom == g_image_bmp_atom)
+            {
+                target_name = "image/bmp";
+            }
+            else if (target_atom == g_file_atom1)
+            {
+                target_name = "text/uri-list";
+            }
+            else if (target_atom == g_file_atom2)
+            {
+                target_name = "x-special/gnome-copied-files";
+            }
+            target_names_remaining =
+                (int)sizeof(target_names) - target_names_length;
+            target_names_written = g_snprintf(
+                target_names + target_names_length,
+                target_names_remaining, "%s%s@0x%lx",
+                target_index == 0 ? "" : ",", target_name,
+                (unsigned long)target_atom);
+            if (target_names_written < 0 ||
+                    target_names_written >= target_names_remaining)
+            {
+                target_names[sizeof(target_names) - 1] = '\0';
+                target_names_truncated = 1;
+                break;
+            }
+            target_names_length += target_names_written;
+        }
+
+        targets_result = clipboard_provide_selection(
+            lxev, XA_ATOM, 32, (char *)atom_buf, atom_count);
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=targets-response-issued "
+            "requestor=0x%lx generation=%llu target_count=%d "
+            "targets=%s truncated=%d result=%d",
+            lxev->requestor,
+            (unsigned long long)g_clipboard_format_generation,
+            atom_count, target_names, target_names_truncated, targets_result);
+        return targets_result;
     }
