@@ -0,0 +1,116 @@
+/* Bounded storage for duplicate X11 image selection requests. */
+
+#ifndef CLIPBOARD_IMAGE_WAITERS_H
+#define CLIPBOARD_IMAGE_WAITERS_H
+
+#include <X11/Xlib.h>
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define CLIPBOARD_IMAGE_WAITER_CAPACITY 8
+
+struct clipboard_image_waiters
+{
+    XSelectionRequestEvent events[CLIPBOARD_IMAGE_WAITER_CAPACITY];
+    Atom target;
+    uint64_t format_generation;
+    size_t count;
+};
+
+enum clipboard_image_waiter_result
+{
+    CLIPBOARD_IMAGE_WAITER_ADDED = 0,
+    CLIPBOARD_IMAGE_WAITER_INVALID,
+    CLIPBOARD_IMAGE_WAITER_MISMATCH,
+    CLIPBOARD_IMAGE_WAITER_FULL
+};
+
+static inline int
+clipboard_image_waiter_request_matches(
+    const XSelectionRequestEvent *event, Atom target, Atom current_target,
+    Atom image_bmp, Atom image_png, uint64_t format_generation,
+    uint64_t request_generation, int request_is_current)
+{
+    return event != NULL && event->property != None &&
+           (target == image_bmp || target == image_png) &&
+           event->target == target && target == current_target &&
+           format_generation != 0 &&
+           format_generation == request_generation && request_is_current;
+}
+
+static inline int
+clipboard_image_waiters_cached_image_matches(
+    Atom target, Atom cached_target, uint64_t format_generation,
+    uint64_t cached_generation, int converted)
+{
+    return (target == cached_target) && format_generation != 0 &&
+           format_generation == cached_generation && converted;
+}
+
+static inline void
+clipboard_image_waiters_clear(struct clipboard_image_waiters *waiters)
+{
+    if (waiters != NULL)
+    {
+        waiters->target = None;
+        waiters->format_generation = 0;
+        waiters->count = 0;
+    }
+}
+
+static inline enum clipboard_image_waiter_result
+clipboard_image_waiters_add(struct clipboard_image_waiters *waiters,
+                            const XSelectionRequestEvent *event,
+                            Atom target, uint64_t format_generation)
+{
+    if (waiters == NULL || event == NULL || event->property == None ||
+            target == None || event->target != target ||
+            format_generation == 0)
+    {
+        return CLIPBOARD_IMAGE_WAITER_INVALID;
+    }
+    if (waiters->count != 0 &&
+            (waiters->target != target ||
+             waiters->format_generation != format_generation))
+    {
+        return CLIPBOARD_IMAGE_WAITER_MISMATCH;
+    }
+    if (waiters->count >= CLIPBOARD_IMAGE_WAITER_CAPACITY)
+    {
+        return CLIPBOARD_IMAGE_WAITER_FULL;
+    }
+
+    if (waiters->count == 0)
+    {
+        waiters->target = target;
+        waiters->format_generation = format_generation;
+    }
+    waiters->events[waiters->count++] = *event;
+    return CLIPBOARD_IMAGE_WAITER_ADDED;
+}
+
+static inline int
+clipboard_image_waiters_take(struct clipboard_image_waiters *waiters,
+                             XSelectionRequestEvent *event)
+{
+    size_t index;
+
+    if (waiters == NULL || event == NULL || waiters->count == 0)
+    {
+        return 0;
+    }
+    *event = waiters->events[0];
+    --waiters->count;
+    for (index = 0; index < waiters->count; ++index)
+    {
+        waiters->events[index] = waiters->events[index + 1];
+    }
+    if (waiters->count == 0)
+    {
+        clipboard_image_waiters_clear(waiters);
+    }
+    return 1;
+}
+
+#endif /* CLIPBOARD_IMAGE_WAITERS_H */
