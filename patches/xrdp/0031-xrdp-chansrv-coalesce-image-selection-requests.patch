+static const char *
+clipboard_image_target_name(Atom target)
+{
+    if (target == g_image_bmp_atom)
+    {
+        return "image/bmp";
+    }
+    if (target == g_image_png_atom)
+    {
+        return "image/png";
+    }
+    return "unknown";
+}
+
+static void
+clipboard_refuse_image_waiters(void)
+{
+    XSelectionRequestEvent event;
+
+    while (clipboard_image_waiters_take(&g_image_waiters, &event))
+    {
+        clipboard_refuse_selection(&event);
+    }
+}
+
+static int
+clipboard_queue_image_waiter(XSelectionRequestEvent *event, Atom target,
+                             uint64_t format_generation)
+{
+    enum clipboard_image_waiter_result result;
+
+    result = clipboard_image_waiters_add(&g_image_waiters, event, target,
+                                         format_generation);
+    if (result == CLIPBOARD_IMAGE_WAITER_ADDED)
+    {
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=request-coalesced target=%s "
+            "waiters=%u",
+            clipboard_image_target_name(target),
+            (unsigned int)g_image_waiters.count);
+        return 1;
+    }
+
+    if (result == CLIPBOARD_IMAGE_WAITER_FULL)
+    {
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=request-refused "
+            "reason=image-waiter-capacity target=%s",
+            clipboard_image_target_name(target));
+    }
+    else
+    {
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=request-refused "
+            "reason=image-waiter-mismatch target=%s",
+            clipboard_image_target_name(target));
+    }
+    clipboard_refuse_selection(event);
+    return 0;
+}
+
+static void
+clipboard_drain_image_waiters(void)
+{
+    XSelectionRequestEvent event;
+
+    if (g_clip_c2s.incr_in_progress || g_image_incr_terminator_pending)
+    {
+        return;
+    }
+    if (g_image_waiters.count == 0)
+    {
+        return;
+    }
+    if (!g_clip_c2s.converted ||
+            g_image_waiters.target != g_clip_c2s.type ||
+            g_image_waiters.format_generation != g_clipboard_format_generation ||
+            g_image_cached_generation != g_clipboard_format_generation)
+    {
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=waiters-refused "
+            "reason=stale-generation waiters=%u",
+            (unsigned int)g_image_waiters.count);
+        clipboard_refuse_image_waiters();
+        return;
+    }
+
+    while (!g_clip_c2s.incr_in_progress &&
+            clipboard_image_waiters_take(&g_image_waiters, &event))
+    {
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=waiter-served target=%s "
+            "remaining=%u",
+            clipboard_image_target_name(event.target),
+            (unsigned int)g_image_waiters.count);
+        clipboard_provide_selection_c2s(&event, event.target);
+    }
+}
+
+static void
+clipboard_invalidate_image_request(const char *reason)
+{
+    if (clipboard_image_retry_active(&g_image_retry.policy) &&
+            g_clip_c2s.xrdp_clip_type == XRDP_CB_BITMAP &&
+            g_clip_c2s.in_request != 0)
+    {
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=request-invalidated reason=%s "
+            "format_id=%d",
+            reason, g_image_retry.format_id);
+        if (!g_image_original_refused)
+        {
+            clipboard_refuse_selection(&g_saved_selection_req_event);
+            g_image_original_refused = 1;
+        }
+        g_image_request_invalidated = 1;
+        clipboard_refuse_image_waiters();
+    }
+    else if (clipboard_image_retry_active(&g_image_retry.policy) &&
+             g_image_retry.retry_timeout_pending)
+    {
+        clipboard_cancel_pending_image_retry(reason);
+    }
+    else
+    {
+        clipboard_refuse_image_waiters();
+    }
+
+    if (g_clip_c2s.xrdp_clip_type == XRDP_CB_BITMAP ||
+            g_image_waiters.count > 0)
+    {
+        g_image_cached_generation = 0;
+        g_clip_c2s.converted = 0;
+    }
+}
