+static void
+set_test_monitors(struct monitor_info *monitors)
+{
+    monitors[0].left = 0;
+    monitors[0].top = 0;
+    monitors[0].right = 99;
+    monitors[0].bottom = 99;
+    monitors[1].left = 1000;
+    monitors[1].top = 0;
+    monitors[1].right = 1099;
+    monitors[1].bottom = 99;
+}
+
+static int
+region_rect_count(struct xrdp_region *region)
+{
+    struct xrdp_rect rect;
+    int count = 0;
+
+    while (xrdp_region_get_rect(region, count, &rect) == 0)
+    {
+        ++count;
+    }
+
+    return count;
+}
+
+static void
+test_console_offscreen_predicate_is_fail_closed(void **state)
+{
+    struct monitor_info monitors[2] = {{0}};
+    struct xrdp_rect rect = {120, 10, 130, 20};
+    UNUSED(state);
+
+    set_test_monitors(monitors);
+    assert_int_equal(1, xrdp_mm_console_rect_is_definitely_offscreen(
+                         &rect, 1200, 800, 2, monitors));
+
+    rect.left = 1000;
+    rect.right = 1010;
+    assert_int_equal(0, xrdp_mm_console_rect_is_definitely_offscreen(
+                         &rect, 1200, 800, 2, monitors));
+    assert_int_equal(0, xrdp_mm_console_rect_is_definitely_offscreen(
+                         &rect, 1200, 800, 2, NULL));
+    assert_int_equal(0, xrdp_mm_console_rect_is_definitely_offscreen(
+                         &rect, 1200, 800,
+                         CLIENT_MONITOR_DATA_MAXIMUM_MONITORS + 1U,
+                         monitors));
+
+    monitors[1].right = monitors[1].left - 1;
+    rect.left = 120;
+    rect.right = 130;
+    assert_int_equal(0, xrdp_mm_console_rect_is_definitely_offscreen(
+                         &rect, 1200, 800, 2, monitors));
+    assert_int_equal(0, xrdp_mm_console_rect_is_definitely_offscreen(
+                         &rect, 0, 800, 0, NULL));
+    assert_int_equal(0, xrdp_mm_console_rect_is_definitely_offscreen(
+                         NULL, 1200, 800, 0, NULL));
+
+    rect.right = rect.left;
+    assert_int_equal(0, xrdp_mm_console_rect_is_definitely_offscreen(
+                         &rect, 1200, 800, 0, NULL));
+    rect.left = -20;
+    rect.right = -10;
+    rect.top = 10;
+    rect.bottom = 20;
+    assert_int_equal(1, xrdp_mm_console_rect_is_definitely_offscreen(
+                         &rect, 1200, 800, 0, NULL));
+    rect.left = -1;
+    rect.right = 1;
+    assert_int_equal(0, xrdp_mm_console_rect_is_definitely_offscreen(
+                         &rect, 1200, 800, 0, NULL));
+}
+
+static void
+test_console_stale_prefix_commits_transactionally(void **state)
+{
+    struct monitor_info monitors[2] = {{0}};
+    struct xrdp_console_dirty_region_scan scan = {0};
+    struct xrdp_region *region = xrdp_region_create(NULL);
+    struct xrdp_rect stale[XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH];
+    struct xrdp_rect visible = {1000, 10, 1010, 20};
+    struct xrdp_rect rect;
+    int index;
+    UNUSED(state);
+
+    assert_non_null(region);
+    set_test_monitors(monitors);
+    for (index = 0;
+         index < XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH;
+         ++index)
+    {
+        rect.left = 120 + index * 20;
+        rect.top = 10;
+        rect.right = rect.left + 10;
+        rect.bottom = 20;
+        assert_int_equal(0, xrdp_region_add_rect(region, &rect));
+    }
+    assert_int_equal(0, xrdp_region_add_rect(region, &visible));
+    assert_int_equal(XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH + 1,
+                     region_rect_count(region));
+
+    assert_int_equal(0, xrdp_mm_console_scan_dirty_region(
+                         region, 1200, 800, 2, monitors, &scan));
+    assert_int_equal(XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH,
+                     scan.count);
+    for (index = 0;
+         index < XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH;
+         ++index)
+    {
+        assert_int_equal(120 + index * 20, scan.rectangles[index].left);
+        assert_int_equal(1, scan.definitely_offscreen[index]);
+        stale[index] = scan.rectangles[index];
+    }
+
+    /* A failed send or FRAME_END never commits either class of dirty work. */
+    assert_int_equal(0, xrdp_mm_console_commit_dirty_region(
+                         region, NULL, 0, stale,
+                         XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH, 0));
+    assert_int_equal(XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH + 1,
+                     region_rect_count(region));
+
+    assert_int_equal(0, xrdp_mm_console_commit_dirty_region(
+                         region, NULL, 0, stale,
+                         XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH, 1));
+    assert_int_equal(1, region_rect_count(region));
+    assert_int_equal(0, xrdp_region_get_rect(region, 0, &rect));
+    assert_int_equal(visible.left, rect.left);
+    assert_int_equal(visible.top, rect.top);
+    assert_int_equal(visible.right, rect.right);
+    assert_int_equal(visible.bottom, rect.bottom);
+
+    assert_int_equal(0, xrdp_mm_console_scan_dirty_region(
+                         region, 1200, 800, 2, monitors, &scan));
+    assert_int_equal(1, scan.count);
+    assert_int_equal(0, scan.definitely_offscreen[0]);
+    assert_int_equal(visible.left, scan.rectangles[0].left);
+    assert_int_equal(0, xrdp_mm_console_commit_dirty_region(
+                         region, &visible, 1, NULL, 0, 1));
+    assert_int_equal(0, region_rect_count(region));
+    xrdp_region_delete(region);
+}
