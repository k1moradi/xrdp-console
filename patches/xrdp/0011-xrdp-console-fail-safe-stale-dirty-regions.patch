+/*****************************************************************************/
+int
+xrdp_mm_console_scan_dirty_region(
+    struct xrdp_region *region, int screen_width, int screen_height,
+    unsigned int monitor_count, const struct monitor_info *monitors,
+    struct xrdp_console_dirty_region_scan *scan)
+{
+    struct xrdp_rect rect;
+    int index;
+
+    if (region == NULL || scan == NULL)
+    {
+        return 1;
+    }
+
+    scan->count = 0;
+    for (index = 0;
+         index < XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH;
+         ++index)
+    {
+        if (xrdp_region_get_rect(region, index, &rect) != 0)
+        {
+            break;
+        }
+
+        scan->rectangles[index] = rect;
+        scan->definitely_offscreen[index] =
+            xrdp_mm_console_rect_is_definitely_offscreen(
+                &rect, screen_width, screen_height,
+                monitor_count, monitors);
+        ++scan->count;
+    }
+
+    return 0;
+}
