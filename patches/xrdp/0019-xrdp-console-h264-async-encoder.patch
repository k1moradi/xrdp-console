-        cmocka_unit_test(test_console_interaction_priority_state),
+        cmocka_unit_test(test_console_interaction_priority_state),
+        cmocka_unit_test(test_console_generic_encoder_policy),
     };
 
     ck_assert_int_eq(cmocka_run_group_tests(tests, NULL, NULL), 0);
