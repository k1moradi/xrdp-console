     struct xrdp_console_gfx_ack_telemetry *telemetry,
@@ -1746,6 +1758,8 @@ xrdp_mm_egfx_caps_advertise(void *user, int num_caps,
         self->egfx_up = 1;
         xrdp_mm_egfx_create_surfaces(self);
-        if (self->code != XRDP_CONSOLE_SESSION_CODE)
