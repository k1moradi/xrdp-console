+                self->egfx_flags))
         {
             self->encoder = xrdp_encoder_create(self);
         }
@@ -1773,6 +1788,8 @@ xrdp_mm_egfx_caps_advertise(void *user, int num_caps,
         self->wm->client_info->gfx = 0;
         xrdp_encoder_delete(self->encoder);
-        if (self->code != XRDP_CONSOLE_SESSION_CODE)
+        if (xrdp_mm_console_generic_encoder_allowed(
+                self->code, self->wm->client_info->gfx,
+                self->egfx_flags))
         {
             self->encoder = xrdp_encoder_create(self);
         }
@@ -2753,9 +2771,11 @@ process_display_control_monitor_layout_data(struct xrdp_wm *wm)
         case WMRZ_ENCODER_CREATE:
             if (mm->egfx_up)
             {
                 xrdp_mm_egfx_create_surfaces(mm);
             }
-            if (mm->code != XRDP_CONSOLE_SESSION_CODE)
+            if (xrdp_mm_console_generic_encoder_allowed(
+                    mm->code, mm->wm->client_info->gfx,
+                    mm->egfx_flags))
             {
                 mm->encoder = xrdp_encoder_create(mm);
             }
@@ -3591,10 +3612,16 @@ xrdp_mm_connect(struct xrdp_mm *self)
 
-    /* The first-party console owns its synchronous RemoteFX encoder. The
-     * generic xrdp encoder was created before the module code was parsed. */
-    if (self->code == XRDP_CONSOLE_SESSION_CODE && self->encoder != NULL)
+    /*
+     * GFX capabilities can be negotiated before the module code is parsed.
+     * Console owns synchronous RemoteFX/Planar output, but negotiated H.264
+     * deliberately retains xrdp's asynchronous encoder.
+     */
+    if (self->encoder != NULL &&
+            !xrdp_mm_console_generic_encoder_allowed(
+                self->code, self->wm->client_info->gfx,
+                self->egfx_flags))
     {
         LOG(LOG_LEVEL_INFO,
-            "xrdp-console: disabling xrdp generic encoder thread");
+            "xrdp-console: disabling non-H264 generic encoder thread");
         xrdp_encoder_delete(self->encoder);
         self->encoder = NULL;
     }
diff --git a/tests/xrdp/test_xrdp_region.c b/tests/xrdp/test_xrdp_region.c
--- a/tests/xrdp/test_xrdp_region.c
+++ b/tests/xrdp/test_xrdp_region.c
@@ -518,6 +518,33 @@ test_console_interaction_priority_state(void **state)
         &priority, 1366, 768, 982, 512, 384, 256));
 }
 
+static void
+test_console_generic_encoder_policy(void **state)
+{
+    UNUSED(state);
+
+    /* Legacy session codes keep upstream encoder selection unchanged. */
+    assert_int_equal(1, xrdp_mm_console_generic_encoder_allowed(
+                            0, 0, 0));
+    assert_int_equal(1, xrdp_mm_console_generic_encoder_allowed(
+                            1, 0, XRDP_EGFX_RFX_PRO));
+
+    /* Console must not revive the encoder for classic, Planar, or Pro-RFX. */
+    assert_int_equal(0, xrdp_mm_console_generic_encoder_allowed(
+                            XRDP_CONSOLE_SESSION_CODE, 0, 0));
+    assert_int_equal(0, xrdp_mm_console_generic_encoder_allowed(
+                            XRDP_CONSOLE_SESSION_CODE, 1,
+                            XRDP_EGFX_RFX_PRO));
+    assert_int_equal(0, xrdp_mm_console_generic_encoder_allowed(
+                            XRDP_CONSOLE_SESSION_CODE, 0,
+                            XRDP_EGFX_H264));
+
+    /* Negotiated Console H.264 is the only generic-encoder exception. */
+    assert_int_equal(1, xrdp_mm_console_generic_encoder_allowed(
+                            XRDP_CONSOLE_SESSION_CODE, 1,
+                            XRDP_EGFX_H264));
+}
+
