diff --git a/xrdp/xrdp_mm.c b/xrdp/xrdp_mm.c
--- a/xrdp/xrdp_mm.c
+++ b/xrdp/xrdp_mm.c
@@ -1338,6 +1338,18 @@ xrdp_mm_console_gfx_effective_flush_ms(
     return minimum_flush_ms;
 }
 
+int
+xrdp_mm_console_generic_encoder_allowed(
+    int session_code, int gfx_enabled, enum xrdp_egfx_flags egfx_flags)
+{
+    if (session_code != XRDP_CONSOLE_SESSION_CODE)
+    {
+        return 1;
+    }
+
+    return gfx_enabled && egfx_flags == XRDP_EGFX_H264;
+}
