+static void
+clipboard_cancel_stale_local_format_discovery(void)
+{
+    if (!clipboard_retry_policy_active(&g_selection_retry.policy) ||
+            g_selection_retry.target != g_targets_atom ||
+            g_selection_retry.data_response_expected)
+    {
+        return;
+    }
+
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_CLIPBOARD_RETRY cancel target=TARGETS "
+        "reason=remote-format-list retry_generation=%llu attempt=%u",
+        (unsigned long long)g_selection_retry.policy.generation,
+        g_selection_retry.policy.attempt);
+    clipboard_retry_policy_cancel(&g_selection_retry.policy);
+    g_selection_retry.target = None;
+    g_selection_retry.time = CurrentTime;
+    g_selection_retry.data_response_expected = 0;
+    g_selection_retry.retry_timeout_pending = 0;
+}
