+    in_uint16_le(s, cache_slot);
+    in_uint16_le(s, surface_id);
+    in_uint16_le(s, point_count);
+    in_uint16_le(s, x0);
+    in_uint16_le(s, y0);
+    in_uint16_le(s, x1);
+    in_uint16_le(s, y1);
