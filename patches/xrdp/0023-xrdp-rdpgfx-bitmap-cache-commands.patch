+    ck_assert_int_eq(0xE0, descriptor);
+    ck_assert_int_eq(0x04, bulk_header);
+    ck_assert_int_eq(XR_RDPGFX_CMDID_CACHETOSURFACE, command_id);
+    ck_assert_int_eq(0, flags);
+    ck_assert_int_eq(22, pdu_length);
+    ck_assert_int_eq(0x2468, cache_slot);
+    ck_assert_int_eq(0x1357, surface_id);
+    ck_assert_int_eq(2, point_count);
+    ck_assert_int_eq(7, x0);
+    ck_assert_int_eq(9, y0);
+    ck_assert_int_eq(101, x1);
+    ck_assert_int_eq(203, y1);
+    ck_assert_ptr_eq(s->p, s->end);
+
+    free_stream(s);
+    g_free(bulk);
+}
+END_TEST
