+START_TEST(test_xrdp_egfx_surface_to_cache__wire_layout)
+{
+    struct xrdp_egfx_bulk *bulk = g_new0(struct xrdp_egfx_bulk, 1);
+    const struct xrdp_egfx_rect rect = {11, 22, 75, 86};
+    struct stream *s;
+    unsigned char descriptor;
+    unsigned char bulk_header;
+    unsigned short command_id;
+    unsigned short flags;
+    unsigned int pdu_length;
+    unsigned short surface_id;
+    uint64_t cache_key;
+    unsigned short cache_slot;
+    unsigned short left;
+    unsigned short top;
+    unsigned short right;
+    unsigned short bottom;
+
+    s = xrdp_egfx_surface_to_cache(
+            bulk, 0x1234, UINT64_C(0x1122334455667788), 0x5678, &rect);
+    ck_assert_ptr_nonnull(s);
+    ck_assert_int_eq(30, (int) (s->end - s->data));
+
+    s->p = s->data;
+    in_uint8(s, descriptor);
+    in_uint8(s, bulk_header);
+    in_uint16_le(s, command_id);
+    in_uint16_le(s, flags);
+    in_uint32_le(s, pdu_length);
+    in_uint16_le(s, surface_id);
+    in_uint64_le(s, cache_key);
+    in_uint16_le(s, cache_slot);
+    in_uint16_le(s, left);
+    in_uint16_le(s, top);
+    in_uint16_le(s, right);
+    in_uint16_le(s, bottom);
+
+    ck_assert_int_eq(0xE0, descriptor);
+    ck_assert_int_eq(0x04, bulk_header);
+    ck_assert_int_eq(XR_RDPGFX_CMDID_SURFACETOCACHE, command_id);
+    ck_assert_int_eq(0, flags);
+    ck_assert_int_eq(28, pdu_length);
+    ck_assert_int_eq(0x1234, surface_id);
+    ck_assert_msg(cache_key == UINT64_C(0x1122334455667788),
+                  "cache key byte order mismatch");
+    ck_assert_int_eq(0x5678, cache_slot);
+    ck_assert_int_eq(11, left);
+    ck_assert_int_eq(22, top);
+    ck_assert_int_eq(75, right);
+    ck_assert_int_eq(86, bottom);
+    ck_assert_ptr_eq(s->p, s->end);
+
+    free_stream(s);
+    g_free(bulk);
+}
+END_TEST
