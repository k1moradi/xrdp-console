@@ -1143,0 +1144,31 @@
+
+/*****************************************************************************/
+/* Send exact dirty rectangles for the direct console. The legacy GFX path
+ * intentionally retains its historical single-bounds behavior. */
+static int
+xrdp_mm_egfx_send_planar_region(struct xrdp_mm *self,
+                                struct xrdp_bitmap *bitmap,
+                                struct xrdp_region *region,
+                                int surface_id, int x, int y)
+{
+    int index = 0;
+    int rv;
+    struct xrdp_rect rect;
+
+    if (region == NULL || !xrdp_region_not_empty(region))
+    {
+        return 0;
+    }
+
+    while (xrdp_region_get_rect(region, index, &rect) == 0)
+    {
+        rv = xrdp_mm_egfx_send_planar_bitmap(self, bitmap, &rect,
+                                             surface_id, x, y);
+        if (rv != 0)
+        {
+            return rv;
+        }
+        ++index;
+    }
+    return 0;
+}
