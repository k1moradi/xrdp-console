+static void
+test_console_planar_fresh_and_continuation_pacing(void **state)
+{
+    int continuation;
+    UNUSED(state);
+
+    /* Legacy session pacing is invariant even if the Console flag is set. */
+    assert_int_equal(40, xrdp_mm_console_gfx_minimum_flush_ms(0, 0));
+    assert_int_equal(40, xrdp_mm_console_gfx_minimum_flush_ms(0, 1));
+
+    /* A fresh Console batch coalesces; successful pending work continues. */
+    continuation = xrdp_mm_console_planar_continuation_state(0, 0);
+    assert_int_equal(0, continuation);
+    assert_int_equal(16, xrdp_mm_console_gfx_minimum_flush_ms(
+                             XRDP_CONSOLE_SESSION_CODE, continuation));
+
+    continuation = xrdp_mm_console_planar_continuation_state(1, 1);
+    assert_int_equal(1, continuation);
+    assert_int_equal(0, xrdp_mm_console_gfx_minimum_flush_ms(
+                            XRDP_CONSOLE_SESSION_CODE, continuation));
+
+    /* Final drain clears the flag so subsequent damage coalesces again. */
+    continuation = xrdp_mm_console_planar_continuation_state(1, 0);
+    assert_int_equal(0, continuation);
+    assert_int_equal(16, xrdp_mm_console_gfx_minimum_flush_ms(
+                             XRDP_CONSOLE_SESSION_CODE, continuation));
+
+    /* Failed sends / FRAME_END cannot leave a zero-delay retry loop. */
+    continuation = xrdp_mm_console_planar_continuation_state(0, 1);
+    assert_int_equal(0, continuation);
+    assert_int_equal(16, xrdp_mm_console_gfx_minimum_flush_ms(
+                             XRDP_CONSOLE_SESSION_CODE, continuation));
+}
