+static void
+clipboard_finish_selection_conversion(Atom target)
+{
+    if (clipboard_retry_policy_active(&g_selection_retry.policy) &&
+            target == g_selection_retry.target)
+    {
+        clipboard_retry_policy_reset(&g_selection_retry.policy);
+        g_selection_retry.target = None;
+        g_selection_retry.time = CurrentTime;
+        g_selection_retry.data_response_expected = 0;
+        g_selection_retry.retry_timeout_pending = 0;
+    }
+}
+
+static void
+clipboard_fail_selection_conversion(Atom target)
+{
+    if (!clipboard_retry_policy_active(&g_selection_retry.policy) ||
+            target != g_selection_retry.target)
+    {
+        return;
+    }
+
+    LOG(LOG_LEVEL_ERROR,
+        "XRDP_CONSOLE_CLIPBOARD_RETRY exhausted target=%s attempts=%u",
+        get_atom_text(target), g_selection_retry.policy.attempt);
+    if (g_selection_retry.data_response_expected)
+    {
+        clipboard_send_data_response_failed();
+    }
+    clipboard_finish_selection_conversion(target);
+}
+
+static int
+clipboard_schedule_selection_retry(void);
+static int
+clipboard_schedule_selection_response_timeout(void);
+
+static void
+clipboard_selection_retry_timeout(void *data)
+{
+    struct clipboard_selection_retry_timeout *timeout_context;
+    uint64_t generation;
+    unsigned int attempt;
+
+    timeout_context = (struct clipboard_selection_retry_timeout *) data;
+    if (timeout_context == NULL)
+    {
+        return;
+    }
+    generation = timeout_context->generation;
+    attempt = timeout_context->attempt;
+    g_free(timeout_context);
+
+    if (!g_clip_up || g_wnd == 0 ||
+            !clipboard_retry_policy_attempt_matches(
+                &g_selection_retry.policy, generation, attempt))
+    {
+        return;
+    }
+    g_selection_retry.retry_timeout_pending = 0;
+    if (!clipboard_retry_policy_can_retry(&g_selection_retry.policy))
+    {
+        clipboard_fail_selection_conversion(g_selection_retry.target);
+        return;
+    }
+    if (!clipboard_retry_policy_advance(&g_selection_retry.policy))
+    {
+        clipboard_fail_selection_conversion(g_selection_retry.target);
+        return;
+    }
+
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_CLIPBOARD_RETRY retry target=%s attempt=%u",
+        get_atom_text(g_selection_retry.target),
+        g_selection_retry.policy.attempt);
+    XConvertSelection(g_display, g_clipboard_atom, g_selection_retry.target,
+                      g_clip_property_atom, g_wnd, g_selection_retry.time);
+    XFlush(g_display);
+    if (!clipboard_schedule_selection_response_timeout())
+    {
+        clipboard_fail_selection_conversion(g_selection_retry.target);
+    }
+}
+
+static int
+clipboard_schedule_selection_retry(void)
+{
+    struct clipboard_selection_retry_timeout *timeout_context;
+
+    if (!clipboard_retry_policy_active(&g_selection_retry.policy) ||
+            g_selection_retry.retry_timeout_pending ||
+            !clipboard_retry_policy_can_retry(&g_selection_retry.policy))
+    {
+        return 0;
+    }
+    timeout_context = g_new0(struct clipboard_selection_retry_timeout, 1);
+    if (timeout_context == NULL)
+    {
+        return 0;
+    }
+    timeout_context->generation = g_selection_retry.policy.generation;
+    timeout_context->attempt = g_selection_retry.policy.attempt;
+    if (add_timeout(CLIPBOARD_SELECTION_RETRY_DELAY_MS,
+                    clipboard_selection_retry_timeout, timeout_context) != 0)
+    {
+        g_free(timeout_context);
+        return 0;
+    }
+    g_selection_retry.retry_timeout_pending = 1;
+    return 1;
+}
+
+static void
+clipboard_selection_response_timeout(void *data)
+{
+    struct clipboard_selection_retry_timeout *timeout_context;
+    uint64_t generation;
+    unsigned int attempt;
+
+    timeout_context = (struct clipboard_selection_retry_timeout *) data;
+    if (timeout_context == NULL)
+    {
+        return;
+    }
+    generation = timeout_context->generation;
+    attempt = timeout_context->attempt;
+    g_free(timeout_context);
+
+    if (!g_clip_up || g_wnd == 0 ||
+            !clipboard_retry_policy_attempt_matches(
+                &g_selection_retry.policy, generation, attempt))
+    {
+        return;
+    }
+
+    LOG(LOG_LEVEL_ERROR,
+        "XRDP_CONSOLE_CLIPBOARD_RETRY response_timeout target=%s attempt=%u",
+        get_atom_text(g_selection_retry.target), attempt);
+    clipboard_fail_selection_conversion(g_selection_retry.target);
+}
+
+static int
+clipboard_schedule_selection_response_timeout(void)
+{
+    struct clipboard_selection_retry_timeout *timeout_context;
+
+    if (!clipboard_retry_policy_active(&g_selection_retry.policy))
+    {
+        return 0;
+    }
+    timeout_context = g_new0(struct clipboard_selection_retry_timeout, 1);
+    if (timeout_context == NULL)
+    {
+        return 0;
+    }
+    timeout_context->generation = g_selection_retry.policy.generation;
+    timeout_context->attempt = g_selection_retry.policy.attempt;
+    if (add_timeout(CLIPBOARD_SELECTION_RESPONSE_TIMEOUT_MS,
+                    clipboard_selection_response_timeout,
+                    timeout_context) != 0)
+    {
+        g_free(timeout_context);
+        return 0;
+    }
+    return 1;
+}
+
+static void
+clipboard_begin_selection_conversion(Atom target, Time time,
+                                     int data_response_expected)
+{
+    if (clipboard_retry_policy_active(&g_selection_retry.policy))
+    {
+        if (g_selection_retry.data_response_expected)
+        {
+            clipboard_send_data_response_failed();
+        }
+        clipboard_retry_policy_cancel(&g_selection_retry.policy);
+    }
+
+    clipboard_retry_policy_begin(&g_selection_retry.policy);
+    g_selection_retry.target = target;
+    g_selection_retry.time = time;
+    g_selection_retry.data_response_expected = data_response_expected;
+    g_selection_retry.retry_timeout_pending = 0;
+    XConvertSelection(g_display, g_clipboard_atom, target,
+                      g_clip_property_atom, g_wnd, time);
+    XFlush(g_display);
+    if (!clipboard_schedule_selection_response_timeout())
+    {
+        clipboard_fail_selection_conversion(target);
+    }
+}
+
