+#ifndef CLIPBOARD_RETRY_POLICY_H
+#define CLIPBOARD_RETRY_POLICY_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+enum
+{
+    CLIPBOARD_SELECTION_MAX_ATTEMPTS = 3,
+    CLIPBOARD_SELECTION_RETRY_DELAY_MS = 50,
+    CLIPBOARD_SELECTION_RESPONSE_TIMEOUT_MS = 2000
+};
+
+struct clipboard_retry_policy
+{
+    uint64_t generation;
+    unsigned int attempt;
+};
+
+static inline uint64_t
+clipboard_retry_policy_next_generation(uint64_t generation)
+{
+    return generation == UINT64_MAX ? 1U : generation + 1U;
+}
+
+static inline uint64_t
+clipboard_retry_policy_begin(struct clipboard_retry_policy *policy)
+{
+    if (policy == NULL)
+    {
+        return 0;
+    }
+    policy->generation =
+        clipboard_retry_policy_next_generation(policy->generation);
+    policy->attempt = 1;
+    return policy->generation;
+}
+
+static inline int
+clipboard_retry_policy_active(const struct clipboard_retry_policy *policy)
+{
+    return policy != NULL && policy->attempt != 0;
+}
+
+static inline int
+clipboard_retry_policy_generation_matches(
+    const struct clipboard_retry_policy *policy, uint64_t generation)
+{
+    return clipboard_retry_policy_active(policy) &&
+           generation != 0 && policy->generation == generation;
+}
+
+static inline int
+clipboard_retry_policy_attempt_matches(
+    const struct clipboard_retry_policy *policy,
+    uint64_t generation, unsigned int attempt)
+{
+    return clipboard_retry_policy_generation_matches(policy, generation) &&
+           attempt != 0 && policy->attempt == attempt;
+}
+
+static inline int
+clipboard_retry_policy_can_retry(const struct clipboard_retry_policy *policy)
+{
+    return clipboard_retry_policy_active(policy) &&
+           policy->attempt < CLIPBOARD_SELECTION_MAX_ATTEMPTS;
+}
+
+static inline int
+clipboard_retry_policy_advance(struct clipboard_retry_policy *policy)
+{
+    if (!clipboard_retry_policy_can_retry(policy))
+    {
+        return 0;
+    }
+    ++policy->attempt;
+    return 1;
+}
+
+static inline void
+clipboard_retry_policy_reset(struct clipboard_retry_policy *policy)
+{
+    if (policy != NULL)
+    {
+        policy->attempt = 0;
+    }
+}
+
+static inline void
+clipboard_retry_policy_cancel(struct clipboard_retry_policy *policy)
+{
+    if (policy != NULL)
+    {
+        policy->generation =
+            clipboard_retry_policy_next_generation(policy->generation);
+        policy->attempt = 0;
+    }
+}
+
+#endif /* CLIPBOARD_RETRY_POLICY_H */
