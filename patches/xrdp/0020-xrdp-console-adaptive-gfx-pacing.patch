+static enum xrdp_console_gfx_pacing_level
+xrdp_mm_console_gfx_pacing_level_for_queue(uint32_t queue_depth)
+{
+    if (queue_depth >= XRDP_CONSOLE_GFX_PACING_SEVERE_ENTER_BYTES)
+    {
+        return XRDP_CONSOLE_GFX_PACING_SEVERE;
+    }
+    if (queue_depth >= XRDP_CONSOLE_GFX_PACING_CONGESTED_ENTER_BYTES)
+    {
+        return XRDP_CONSOLE_GFX_PACING_CONGESTED;
+    }
+    if (queue_depth >= XRDP_CONSOLE_GFX_PACING_BALANCED_ENTER_BYTES)
+    {
+        return XRDP_CONSOLE_GFX_PACING_BALANCED;
+    }
+    return XRDP_CONSOLE_GFX_PACING_INTERACTIVE;
+}
+
+static uint32_t
+xrdp_mm_console_gfx_pacing_exit_threshold(
+    enum xrdp_console_gfx_pacing_level level)
+{
+    switch (level)
+    {
+        case XRDP_CONSOLE_GFX_PACING_SEVERE:
+            return XRDP_CONSOLE_GFX_PACING_SEVERE_EXIT_BYTES;
+        case XRDP_CONSOLE_GFX_PACING_CONGESTED:
+            return XRDP_CONSOLE_GFX_PACING_CONGESTED_EXIT_BYTES;
+        case XRDP_CONSOLE_GFX_PACING_BALANCED:
+            return XRDP_CONSOLE_GFX_PACING_BALANCED_EXIT_BYTES;
+        default:
+            return 0;
+    }
+}
+
+void
+xrdp_mm_console_update_gfx_pacing(
+    struct xrdp_console_gfx_pacing_state *pacing,
+    const struct xrdp_console_gfx_ack_telemetry *telemetry)
+{
+    enum xrdp_console_gfx_pacing_level target;
+    uint32_t queue_depth;
+
+    if (pacing == NULL || telemetry == NULL ||
+            telemetry->acknowledgement_count == 0 ||
+            telemetry->acknowledgement_count ==
+                pacing->observed_acknowledgement_count)
+    {
+        return;
+    }
+
+    pacing->observed_acknowledgement_count =
+        telemetry->acknowledgement_count;
+    if (telemetry->acknowledgements_suspended)
+    {
+        /* Queue depth is unavailable while ACKs are suspended. Keep the last
+         * known pacing level, but do not compare a future normal ACK against
+         * a stale pre-suspension queue sample. */
+        pacing->previous_queue_valid = 0;
+        pacing->recovery_acknowledgement_count = 0;
+        return;
+    }
+
+    queue_depth = telemetry->latest_queue_depth;
+    target = xrdp_mm_console_gfx_pacing_level_for_queue(queue_depth);
+
+    if (pacing->previous_queue_valid &&
+            queue_depth > pacing->previous_queue_depth &&
+            queue_depth - pacing->previous_queue_depth >=
+                XRDP_CONSOLE_GFX_PACING_RAPID_RISE_BYTES &&
+            target <= pacing->level &&
+            pacing->level < XRDP_CONSOLE_GFX_PACING_SEVERE)
+    {
+        /* A rapidly growing queue below the next absolute threshold is still
+         * pressure. Promote one level now instead of waiting another ACK. */
+        target = pacing->level + 1;
+    }
+    pacing->previous_queue_depth = queue_depth;
+    pacing->previous_queue_valid = 1;
+
+    if (target > pacing->level)
+    {
+        pacing->level = target;
+        pacing->recovery_acknowledgement_count = 0;
+        return;
+    }
+
+    if (pacing->level == XRDP_CONSOLE_GFX_PACING_INTERACTIVE)
+    {
+        pacing->recovery_acknowledgement_count = 0;
+        return;
+    }
+
+    if (queue_depth <
+            xrdp_mm_console_gfx_pacing_exit_threshold(pacing->level))
+    {
+        if (++pacing->recovery_acknowledgement_count >=
+                XRDP_CONSOLE_GFX_PACING_RECOVERY_ACKNOWLEDGEMENTS)
+        {
+            pacing->level--;
+            pacing->recovery_acknowledgement_count = 0;
+        }
+    }
+    else
+    {
+        pacing->recovery_acknowledgement_count = 0;
+    }
+}
+
+int
+xrdp_mm_console_gfx_adaptive_flush_ms(
+    int session_code, int immediate_continuation,
+    int interaction_priority_pending,
+    const struct xrdp_console_gfx_pacing_state *pacing)
+{
+    int minimum_flush_ms;
+    int pacing_floor_ms = 0;
+
+    minimum_flush_ms = xrdp_mm_console_gfx_minimum_flush_ms(
+                           session_code, immediate_continuation);
+    if (session_code != XRDP_CONSOLE_SESSION_CODE)
+    {
+        return minimum_flush_ms;
+    }
+    if (interaction_priority_pending)
+    {
+        return XRDP_CONSOLE_GFX_CONTINUATION_MS;
+    }
+    if (pacing != NULL)
+    {
+        switch (pacing->level)
+        {
+            case XRDP_CONSOLE_GFX_PACING_BALANCED:
+                pacing_floor_ms =
+                    XRDP_CONSOLE_GFX_PACING_BALANCED_FLUSH_MS;
+                break;
+            case XRDP_CONSOLE_GFX_PACING_CONGESTED:
+                pacing_floor_ms =
+                    XRDP_CONSOLE_GFX_PACING_CONGESTED_FLUSH_MS;
+                break;
+            case XRDP_CONSOLE_GFX_PACING_SEVERE:
+                pacing_floor_ms = XRDP_CONSOLE_GFX_BACKPRESSURE_FLUSH_MS;
+                break;
+            default:
+                break;
+        }
+    }
+    return MAX(minimum_flush_ms, pacing_floor_ms);
+}
