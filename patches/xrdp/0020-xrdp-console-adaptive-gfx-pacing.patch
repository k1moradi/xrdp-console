+static void
+test_console_gfx_adaptive_pacing_promotes_immediately(void **state)
+{
+    struct xrdp_console_gfx_ack_telemetry telemetry = {0};
+    struct xrdp_console_gfx_pacing_state pacing = {0};
+    UNUSED(state);
+
+    assert_int_equal(16, xrdp_mm_console_gfx_adaptive_flush_ms(
+                             XRDP_CONSOLE_SESSION_CODE, 0, 0, &pacing));
+    assert_int_equal(0, xrdp_mm_console_gfx_adaptive_flush_ms(
+                            XRDP_CONSOLE_SESSION_CODE, 1, 0, &pacing));
+    assert_int_equal(40, xrdp_mm_console_gfx_adaptive_flush_ms(
+                             0, 1, 1, &pacing));
+
+    telemetry.acknowledgement_count = 1;
+    telemetry.latest_queue_depth =
+        XRDP_CONSOLE_GFX_PACING_BALANCED_ENTER_BYTES - 1U;
+    xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_INTERACTIVE, pacing.level);
+
+    ++telemetry.acknowledgement_count;
+    telemetry.latest_queue_depth =
+        XRDP_CONSOLE_GFX_PACING_BALANCED_ENTER_BYTES;
+    xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_BALANCED, pacing.level);
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_BALANCED_FLUSH_MS,
+        xrdp_mm_console_gfx_adaptive_flush_ms(
+            XRDP_CONSOLE_SESSION_CODE, 1, 0, &pacing));
+
+    ++telemetry.acknowledgement_count;
+    telemetry.latest_queue_depth = 300U * 1024U;
+    xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_CONGESTED, pacing.level);
+
+    ++telemetry.acknowledgement_count;
+    telemetry.latest_queue_depth = 600U * 1024U;
+    xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_SEVERE, pacing.level);
+    assert_int_equal(XRDP_CONSOLE_GFX_BACKPRESSURE_FLUSH_MS,
+        xrdp_mm_console_gfx_adaptive_flush_ms(
+            XRDP_CONSOLE_SESSION_CODE, 0, 0, &pacing));
+
+    /* Current interaction still bypasses background congestion pacing. */
+    assert_int_equal(0, xrdp_mm_console_gfx_adaptive_flush_ms(
+                            XRDP_CONSOLE_SESSION_CODE, 0, 1, &pacing));
+}
+
+static void
+test_console_gfx_adaptive_pacing_recovers_with_hysteresis(void **state)
+{
+    struct xrdp_console_gfx_ack_telemetry telemetry = {0};
+    struct xrdp_console_gfx_pacing_state pacing = {
+        .level = XRDP_CONSOLE_GFX_PACING_SEVERE
+    };
+    unsigned int index;
+    UNUSED(state);
+
+    for (index = 0;
+         index < XRDP_CONSOLE_GFX_PACING_RECOVERY_ACKNOWLEDGEMENTS - 1U;
+         ++index)
+    {
+        ++telemetry.acknowledgement_count;
+        telemetry.latest_queue_depth = 300U * 1024U;
+        xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+        assert_int_equal(XRDP_CONSOLE_GFX_PACING_SEVERE, pacing.level);
+    }
+    ++telemetry.acknowledgement_count;
+    telemetry.latest_queue_depth = 300U * 1024U;
+    xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_CONGESTED, pacing.level);
+
+    for (index = 0;
+         index < XRDP_CONSOLE_GFX_PACING_RECOVERY_ACKNOWLEDGEMENTS;
+         ++index)
+    {
+        ++telemetry.acknowledgement_count;
+        telemetry.latest_queue_depth = 100U * 1024U;
+        xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    }
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_BALANCED, pacing.level);
+
+    for (index = 0;
+         index < XRDP_CONSOLE_GFX_PACING_RECOVERY_ACKNOWLEDGEMENTS;
+         ++index)
+    {
+        ++telemetry.acknowledgement_count;
+        telemetry.latest_queue_depth = 32U * 1024U;
+        xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    }
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_INTERACTIVE, pacing.level);
+}
+
+static void
+test_console_gfx_adaptive_pacing_handles_rise_suspend_and_duplicates(
+    void **state)
+{
+    struct xrdp_console_gfx_ack_telemetry telemetry = {0};
+    struct xrdp_console_gfx_pacing_state pacing = {0};
+    UNUSED(state);
+
+    telemetry.acknowledgement_count = 1;
+    telemetry.latest_queue_depth = 16U * 1024U;
+    xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    ++telemetry.acknowledgement_count;
+    telemetry.latest_queue_depth = 96U * 1024U;
+    xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_BALANCED, pacing.level);
+
+    /* Duplicate observation is ignored. */
+    telemetry.latest_queue_depth = 600U * 1024U;
+    xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_BALANCED, pacing.level);
+
+    ++telemetry.acknowledgement_count;
+    telemetry.acknowledgements_suspended = 1;
+    xrdp_mm_console_update_gfx_pacing(&pacing, &telemetry);
+    assert_int_equal(XRDP_CONSOLE_GFX_PACING_BALANCED, pacing.level);
+    assert_int_equal(0, pacing.previous_queue_valid);
+    assert_int_equal(0, pacing.recovery_acknowledgement_count);
+}
