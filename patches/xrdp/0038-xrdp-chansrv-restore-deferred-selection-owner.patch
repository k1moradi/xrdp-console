 /*****************************************************************************/
+static void
+clipboard_restore_deferred_selection_owner(Time selection_time)
+{
+    Window owner;
+
+    if (!g_clipboard_owner_update_pending ||
+            g_clip_c2s.incr_in_progress ||
+            g_clip_s2c.incr_in_progress ||
+            g_image_incr_terminator_pending)
+    {
+        return;
+    }
+
+    if (g_num_formatIds == 0 || g_wnd == 0)
+    {
+        g_clipboard_owner_update_pending = 0;
+        return;
+    }
+
+    g_clipboard_owner_update_pending = 0;
+    owner = XGetSelectionOwner(g_display, g_clipboard_atom);
+    if (owner == g_wnd)
+    {
+        g_got_selection = 1;
+        return;
+    }
+
+    /* Use the completing X event's timestamp so a newer local owner change
+     * wins instead of being overwritten by this deferred update. */
+    g_selection_time = selection_time;
+    XSetSelectionOwner(g_display, g_clipboard_atom, g_wnd,
+                       g_selection_time);
+    owner = XGetSelectionOwner(g_display, g_clipboard_atom);
+    if (owner == g_wnd)
+    {
+        g_got_selection = 1;
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=selection-owner-restored "
+            "reason=deferred-format-list generation=%llu owner=0x%lx",
+            (unsigned long long)g_clipboard_format_generation, owner);
+    }
+    else
+    {
+        g_got_selection = 0;
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=selection-owner-restore-declined "
+            "reason=deferred-format-list generation=%llu owner=0x%lx "
+            "chansrv_window=0x%lx",
+            (unsigned long long)g_clipboard_format_generation, owner, g_wnd);
+    }
+}
+
