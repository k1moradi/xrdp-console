+static void
+clipboard_invalidate_pending_format_data_request(const char *reason)
+{
+    struct clipboard_format_data_request *pending =
+        &g_pending_format_data_request;
+
+    if (pending->state != CLIPBOARD_FORMAT_DATA_REQUEST_ACTIVE)
+    {
+        return;
+    }
+
+    pending->state = CLIPBOARD_FORMAT_DATA_REQUEST_INVALIDATED;
+    if (pending->clip_type == XRDP_CB_BITMAP && g_image_original_refused)
+    {
+        pending->selection_refused = 1;
+    }
+    if (!pending->requestor_destroyed && !pending->selection_refused)
+    {
+        clipboard_refuse_selection(&pending->selection_request);
+        pending->selection_refused = 1;
+    }
+
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_CLIPBOARD event=format-data-request-invalidated "
+        "reason=%s format_id=%d generation=%llu target=%s "
+        "requestor_destroyed=%d",
+        reason, pending->format_id,
+        (unsigned long long)pending->generation,
+        get_atom_text(pending->target), pending->requestor_destroyed);
+}
