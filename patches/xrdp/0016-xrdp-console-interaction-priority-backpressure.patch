+    assert_int_equal(0, xrdp_mm_console_gfx_backpressure_active(&telemetry));
+    assert_int_equal(16, xrdp_mm_console_gfx_effective_flush_ms(
+                             XRDP_CONSOLE_SESSION_CODE, 0, 0, 0));
+    assert_int_equal(0, xrdp_mm_console_gfx_effective_flush_ms(
+                            XRDP_CONSOLE_SESSION_CODE, 1, 0, 0));
+    assert_int_equal(40, xrdp_mm_console_gfx_effective_flush_ms(
+                             0, 1, 1, 1));
+
+    xrdp_mm_console_record_gfx_acknowledgement(
+        &telemetry, XRDP_CONSOLE_GFX_CLIENT_QUEUE_HIGH_WATER_BYTES - 1U,
+        1, 1);
+    assert_int_equal(0, xrdp_mm_console_gfx_backpressure_active(&telemetry));
+
+    xrdp_mm_console_record_gfx_acknowledgement(
+        &telemetry, XRDP_CONSOLE_GFX_CLIENT_QUEUE_HIGH_WATER_BYTES,
+        2, 2);
+    assert_int_equal(1, xrdp_mm_console_gfx_backpressure_active(&telemetry));
+    assert_int_equal(XRDP_CONSOLE_GFX_BACKPRESSURE_FLUSH_MS,
+        xrdp_mm_console_gfx_effective_flush_ms(
+            XRDP_CONSOLE_SESSION_CODE, 1, 1, 0));
+    assert_int_equal(0, xrdp_mm_console_gfx_effective_flush_ms(
+                            XRDP_CONSOLE_SESSION_CODE, 0, 1, 1));
+
+    xrdp_mm_console_record_gfx_acknowledgement(
+        &telemetry, XR_SUSPEND_FRAME_ACKNOWLEDGEMENT, 3, 3);
+    assert_int_equal(0, xrdp_mm_console_gfx_backpressure_active(&telemetry));
+
+    xrdp_mm_console_record_gfx_acknowledgement(&telemetry, 0U, 4, 4);
+    assert_int_equal(0, xrdp_mm_console_gfx_backpressure_active(&telemetry));
+}
