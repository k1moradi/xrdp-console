+static int
+xrdp_mm_console_send_priority_rect(
+    struct xrdp_mm *self, struct xrdp_bitmap *bitmap,
+    const struct xrdp_rect *priority_rect,
+    const struct xrdp_rect *clip_rect, int surface_id, int x, int y)
+{
+    struct xrdp_console_planar_batch *batch;
+    struct xrdp_rect clipped;
+    int width;
+    int height;
+    int pixels;
+    int result;
+
+    if (self == NULL || bitmap == NULL || priority_rect == NULL)
+    {
+        return 1;
+    }
+    batch = self->console_planar_batch;
+    if (!self->console_planar_frame_open || batch == NULL ||
+            batch->committed_count >=
+                XRDP_CONSOLE_GFX_MAXIMUM_RECTANGLES_PER_FLUSH)
+    {
+        return 1;
+    }
+
+    clipped = *priority_rect;
+    if (clip_rect != NULL)
+    {
+        clipped.left = MAX(clipped.left, clip_rect->left);
+        clipped.top = MAX(clipped.top, clip_rect->top);
+        clipped.right = MIN(clipped.right, clip_rect->right);
+        clipped.bottom = MIN(clipped.bottom, clip_rect->bottom);
+    }
+    width = clipped.right - clipped.left;
+    height = clipped.bottom - clipped.top;
+    if (width <= 0 || height <= 0)
+    {
+        return 0;
+    }
+    pixels = width * height;
+    if (pixels > XRDP_CONSOLE_GFX_MAXIMUM_PIXELS_PER_FLUSH -
+                     batch->pixels_sent)
+    {
+        return 1;
+    }
+
+    result = xrdp_mm_egfx_send_planar_bitmap(
+                 self, bitmap, &clipped, surface_id, x, y);
+    if (result != 0)
+    {
+        return result;
+    }
+    batch->committed[batch->committed_count++] = clipped;
+    batch->pixels_sent += pixels;
+    ++batch->rectangles_sent;
+    return 0;
+}
