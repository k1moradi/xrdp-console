+static int
+xrdp_mm_console_interaction_bounds(
+    const struct xrdp_console_interaction_priority *priority,
+    int screen_width, int screen_height, struct xrdp_rect *rect)
+{
+    int width;
+    int height;
+    int64_t maximum_left;
+    int64_t maximum_top;
+    int64_t requested_left;
+    int64_t requested_top;
+
+    if (priority == NULL || rect == NULL || !priority->request_valid ||
+            screen_width <= 0 || screen_height <= 0)
+    {
+        return 0;
+    }
+
+    width = MIN(screen_width, XRDP_CONSOLE_INTERACTION_PRIORITY_WIDTH_PIXELS);
+    height = MIN(screen_height,
+                 XRDP_CONSOLE_INTERACTION_PRIORITY_HEIGHT_PIXELS);
+    maximum_left = (int64_t) screen_width - width;
+    maximum_top = (int64_t) screen_height - height;
+    requested_left = (int64_t) priority->request_x - width / 2;
+    requested_top = (int64_t) priority->request_y - height / 2;
+    rect->left = (int) MAX((int64_t) 0,
+                           MIN(maximum_left, requested_left));
+    rect->top = (int) MAX((int64_t) 0,
+                          MIN(maximum_top, requested_top));
+    rect->right = rect->left + width;
+    rect->bottom = rect->top + height;
+    return 1;
+}
+
+void
+xrdp_mm_console_set_interaction_anchor(
+    struct xrdp_console_interaction_priority *priority, int x, int y)
+{
+    if (priority != NULL)
+    {
+        priority->pointer_x = x;
+        priority->pointer_y = y;
+        priority->pointer_valid = 1;
+    }
+}
+
+static void
+xrdp_mm_console_begin_interaction_request(
+    struct xrdp_console_interaction_priority *priority, int x, int y)
+{
+    if (priority == NULL)
+    {
+        return;
+    }
+
+    /* Repeated typing/scrolling at the same anchor must not erase pixels
+     * already marked urgent. Moving the anchor intentionally supersedes the
+     * older priority marker; its pixels remain in the authoritative dirty
+     * region and will be drained as ordinary work. */
+    if (!priority->request_valid || priority->request_x != x ||
+            priority->request_y != y)
+    {
+        priority->dirty_valid = 0;
+    }
+    priority->request_x = x;
+    priority->request_y = y;
+    priority->request_valid = 1;
+}
+
+void
+xrdp_mm_console_set_focus_interaction(
+    struct xrdp_console_interaction_priority *priority, int x, int y)
+{
+    if (priority == NULL)
+    {
+        return;
+    }
+    priority->pointer_x = x;
+    priority->pointer_y = y;
+    priority->pointer_valid = 1;
+    priority->focus_x = x;
+    priority->focus_y = y;
+    priority->focus_valid = 1;
+    xrdp_mm_console_begin_interaction_request(priority, x, y);
+}
+
+void
+xrdp_mm_console_request_pointer_interaction(
+    struct xrdp_console_interaction_priority *priority, int x, int y)
+{
+    if (priority == NULL)
+    {
+        return;
+    }
+    priority->pointer_x = x;
+    priority->pointer_y = y;
+    priority->pointer_valid = 1;
+    xrdp_mm_console_begin_interaction_request(priority, x, y);
+}
+
+int
+xrdp_mm_console_request_focus_interaction(
+    struct xrdp_console_interaction_priority *priority)
+{
+    int request_x;
+    int request_y;
+
+    if (priority == NULL)
+    {
+        return 0;
+    }
+    if (priority->focus_valid)
+    {
+        request_x = priority->focus_x;
+        request_y = priority->focus_y;
+    }
+    else if (priority->pointer_valid)
+    {
+        request_x = priority->pointer_x;
+        request_y = priority->pointer_y;
+    }
+    else
+    {
+        return 0;
+    }
+    xrdp_mm_console_begin_interaction_request(priority, request_x, request_y);
+    return 1;
+}
+
+int
+xrdp_mm_console_record_interaction_damage(
+    struct xrdp_console_interaction_priority *priority,
+    int screen_width, int screen_height,
+    int x, int y, int width, int height)
+{
+    struct xrdp_rect interaction;
+    struct xrdp_rect damaged;
+    int64_t damaged_right;
+    int64_t damaged_bottom;
+
+    if (priority == NULL || width <= 0 || height <= 0 ||
+            !xrdp_mm_console_interaction_bounds(
+                priority, screen_width, screen_height, &interaction))
+    {
+        return 0;
+    }
+
+    damaged_right = (int64_t) x + width;
+    damaged_bottom = (int64_t) y + height;
+    damaged.left = (int) MAX((int64_t) 0, (int64_t) x);
+    damaged.top = (int) MAX((int64_t) 0, (int64_t) y);
+    damaged.right = (int) MAX((int64_t) 0,
+        MIN((int64_t) screen_width, damaged_right));
+    damaged.bottom = (int) MAX((int64_t) 0,
+        MIN((int64_t) screen_height, damaged_bottom));
+    damaged.left = MAX(damaged.left, interaction.left);
+    damaged.top = MAX(damaged.top, interaction.top);
+    damaged.right = MIN(damaged.right, interaction.right);
+    damaged.bottom = MIN(damaged.bottom, interaction.bottom);
+    if (damaged.left >= damaged.right || damaged.top >= damaged.bottom)
+    {
+        return 0;
+    }
+
+    if (!priority->dirty_valid)
+    {
+        priority->dirty = damaged;
+        priority->dirty_valid = 1;
+    }
+    else
+    {
+        priority->dirty.left = MIN(priority->dirty.left, damaged.left);
+        priority->dirty.top = MIN(priority->dirty.top, damaged.top);
+        priority->dirty.right = MAX(priority->dirty.right, damaged.right);
+        priority->dirty.bottom = MAX(priority->dirty.bottom, damaged.bottom);
+    }
+    return 1;
+}
+
+int
+xrdp_mm_console_get_interaction_dirty_rect(
+    const struct xrdp_console_interaction_priority *priority,
+    struct xrdp_rect *rect)
+{
+    if (priority == NULL || rect == NULL || !priority->dirty_valid)
+    {
+        return 0;
+    }
+    *rect = priority->dirty;
+    return 1;
+}
+
+void
+xrdp_mm_console_clear_interaction_dirty(
+    struct xrdp_console_interaction_priority *priority)
+{
+    if (priority != NULL)
+    {
+        priority->dirty_valid = 0;
+        priority->request_valid = 0;
+    }
+}
+
+int
+xrdp_mm_console_gfx_backpressure_active(
+    const struct xrdp_console_gfx_ack_telemetry *telemetry)
+{
+    return telemetry != NULL && telemetry->acknowledgement_count != 0 &&
+           !telemetry->acknowledgements_suspended &&
+           telemetry->latest_queue_depth >=
+               XRDP_CONSOLE_GFX_CLIENT_QUEUE_HIGH_WATER_BYTES;
+}
+
+int
+xrdp_mm_console_gfx_effective_flush_ms(
+    int session_code, int immediate_continuation,
+    int backpressure_active, int interaction_priority_pending)
+{
+    int minimum_flush_ms;
