 /*****************************************************************************/
+static void
+clipboard_event_destroy_notify(XDestroyWindowEvent *event)
+{
+    int c2s_match;
+    int terminator_match;
+    size_t removed_waiters;
+
+    removed_waiters = clipboard_image_waiters_remove_requestor(
+                          &g_image_waiters, event->window);
+    if (removed_waiters > 0)
+    {
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=waiter-discarded "
+            "reason=requestor-destroyed requestor=0x%lx removed=%lu",
+            event->window, (unsigned long)removed_waiters);
+    }
+    c2s_match = g_clip_c2s.incr_in_progress &&
+                event->window == g_clip_c2s.window;
+    terminator_match = g_image_incr_terminator_pending &&
+                       event->window == g_image_incr_terminator_window;
+    if (!c2s_match && !terminator_match)
+    {
+        return;
+    }
+
+    if (c2s_match)
+    {
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=c2s-incr-aborted "
+            "reason=requestor-destroyed requestor=0x%lx "
+            "property=0x%lx bytes_sent=%d total_bytes=%d "
+            "terminator_pending=%d generation=%llu",
+            event->window, g_clip_c2s.property,
+            g_clip_c2s.incr_bytes_done, g_clip_c2s.total_bytes,
+            terminator_match,
+            (unsigned long long)g_clipboard_format_generation);
+    }
+    else if (terminator_match)
+    {
+        LOG(LOG_LEVEL_INFO,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=c2s-incr-terminator-aborted "
+            "reason=requestor-destroyed requestor=0x%lx "
+            "property=0x%lx bytes_sent=%d total_bytes=%d "
+            "generation=%llu",
+            event->window, g_image_incr_terminator_property,
+            g_clip_c2s.incr_bytes_done, g_clip_c2s.total_bytes,
+            (unsigned long long)g_clipboard_format_generation);
+    }
+
+    if (c2s_match)
+    {
+        if (g_png_x11_transaction_active &&
+                g_png_x11_requestor == event->window &&
+                g_png_x11_property == g_clip_c2s.property)
+        {
+            clipboard_png_digest_reset();
+        }
+        g_clip_c2s.incr_in_progress = 0;
+        g_clip_c2s.incr_bytes_done = 0;
+        g_clip_c2s.window = 0;
+        g_clip_c2s.property = None;
+    }
+    if (terminator_match)
+    {
+        if (g_png_x11_transaction_active &&
+                g_png_x11_requestor == event->window &&
+                g_png_x11_property == g_image_incr_terminator_property)
+        {
+            clipboard_png_digest_reset();
+        }
+        g_image_incr_terminator_pending = 0;
+        g_image_incr_terminator_window = 0;
+        g_image_incr_terminator_property = None;
+        g_image_incr_terminator_generation = 0;
+    }
+
+    clipboard_drain_image_waiters();
+    if (g_clipboard_owner_update_pending &&
+            !g_clipboard_owner_update_time_valid)
+    {
+        LOG(LOG_LEVEL_WARNING,
+            "XRDP_CONSOLE_CLIPBOARD_IMAGE event=selection-owner-restore-declined "
+            "reason=missing-deferred-format-list-timestamp "
+            "generation=%llu requestor=0x%lx",
+            (unsigned long long)g_clipboard_format_generation, event->window);
+    }
+    else
+    {
+        clipboard_restore_deferred_selection_owner(
+            g_clipboard_owner_update_time);
+    }
+}
+
