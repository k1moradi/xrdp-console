+static void
+clipboard_png_digest_reset(void)
+{
+    EVP_MD_CTX_free(g_png_x11_digest_context);
+    g_png_x11_digest_context = NULL;
+    g_png_source_sha256[0] = '\0';
+    g_png_source_bytes = 0;
+    g_png_x11_bytes = 0;
+    g_png_x11_announced_bytes = 0;
+    g_png_x11_chunk_count = 0;
+    g_png_x11_digest_status = 0;
+    g_png_x11_request_time = CurrentTime;
+    g_png_x11_start_generation = 0;
+    g_png_x11_requestor = 0;
+    g_png_x11_property = None;
+    g_png_x11_transaction_active = 0;
+}
+
+static int
+clipboard_png_digest_hex(const unsigned char *data, size_t data_bytes,
+                         char output[65])
+{
+    static const char digits[] = "0123456789abcdef";
+    unsigned char digest[EVP_MAX_MD_SIZE];
+    unsigned int digest_bytes = 0;
+    unsigned int index;
+
+    if ((data == NULL && data_bytes != 0) ||
+            EVP_Digest(data, data_bytes, digest, &digest_bytes,
+                       EVP_sha256(), NULL) != 1 || digest_bytes != 32)
+    {
+        output[0] = '\0';
+        return 0;
+    }
+
+    for (index = 0; index < digest_bytes; ++index)
+    {
+        output[index * 2] = digits[digest[index] >> 4];
+        output[index * 2 + 1] = digits[digest[index] & 0x0f];
+    }
+    output[64] = '\0';
+    return 1;
+}
+
+static int
+clipboard_png_digest_to_hex(const unsigned char *digest,
+                            unsigned int digest_bytes, char output[65])
+{
+    static const char digits[] = "0123456789abcdef";
+    unsigned int index;
+
+    if (digest_bytes != 32)
+    {
+        output[0] = '\0';
+        return 0;
+    }
+    for (index = 0; index < digest_bytes; ++index)
+    {
+        output[index * 2] = digits[digest[index] >> 4];
+        output[index * 2 + 1] = digits[digest[index] & 0x0f];
+    }
+    output[64] = '\0';
+    return 1;
+}
+
+static void
+clipboard_png_digest_log_complete(const char *path, const char *x11_sha256,
+                                  unsigned long requestor, Atom property,
+                                  Time request_time, Time delete_time)
+{
+    int hash_match;
+    int length_match;
+
+    hash_match = g_png_source_sha256[0] != '\0' &&
+                 x11_sha256 != NULL && x11_sha256[0] != '\0' &&
+                 g_strcmp(g_png_source_sha256, x11_sha256) == 0;
+    length_match = g_png_source_bytes == g_png_x11_bytes &&
+                   g_png_source_bytes == g_png_x11_announced_bytes;
+    LOG(LOG_LEVEL_INFO,
+        "XRDP_CONSOLE_CLIPBOARD_IMAGE event=png-xchange-arguments-issued "
+        "path=%s requestor=0x%lx property=0x%lx target=image/png "
+        "type=image/png format=8 source_bytes=%llu announced_bytes=%llu "
+        "xchange_argument_bytes=%llu chunks=%u source_sha256=%s "
+        "xchange_argument_sha256=%s "
+        "hash_match=%d length_match=%d request_time=%lu "
+        "last_property_delete_time=%lu start_generation=%llu "
+        "current_generation=%llu",
+        path, requestor, property,
+        (unsigned long long)g_png_source_bytes,
+        (unsigned long long)g_png_x11_announced_bytes,
+        (unsigned long long)g_png_x11_bytes,
+        g_png_x11_chunk_count,
+        g_png_source_sha256[0] != '\0' ? g_png_source_sha256 : "unavailable",
+        x11_sha256 != NULL && x11_sha256[0] != '\0' ?
+            x11_sha256 : "unavailable",
+        hash_match, length_match, request_time, delete_time,
+        (unsigned long long)g_png_x11_start_generation,
+        (unsigned long long)g_clipboard_format_generation);
+}
