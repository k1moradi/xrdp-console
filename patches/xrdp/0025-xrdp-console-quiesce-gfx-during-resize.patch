diff --git a/tests/xrdp/test_xrdp_region.c b/tests/xrdp/test_xrdp_region.c
--- a/tests/xrdp/test_xrdp_region.c
+++ b/tests/xrdp/test_xrdp_region.c
@@ -670,2 +670,18 @@
+static void
+test_console_dirty_gfx_is_held_during_resize(void **state)
+{
+    UNUSED(state);
+
+    /* Hold Console dirty pixels until replacement surfaces are mapped. */
+    assert_int_equal(0, xrdp_mm_console_dirty_gfx_output_allowed(
+                            XRDP_CONSOLE_SESSION_CODE, 1));
+    assert_int_equal(1, xrdp_mm_console_dirty_gfx_output_allowed(
+                            XRDP_CONSOLE_SESSION_CODE, 0));
+
+    /* Other module codes retain upstream dirty-output behavior. */
+    assert_int_equal(1, xrdp_mm_console_dirty_gfx_output_allowed(0, 1));
+    assert_int_equal(1, xrdp_mm_console_dirty_gfx_output_allowed(1, 1));
+}
