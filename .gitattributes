* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.c text eol=lf
# Unified-diff patch files use a leading context marker on empty context lines.
patches/xrdp/*.patch whitespace=-blank-at-eol
patches/xrdp/0040-xrdp-log-window-manager-check-source.patch whitespace=-blank-at-eol,-blank-at-eof
patches/xrdp/0041-xrdp-chansrv-log-png-x11-transaction.patch whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
patches/xrdp/0042-xrdp-chansrv-prefetch-named-png.patch whitespace=-blank-at-eol,-blank-at-eof
patches/xrdp/0017-xrdp-chansrv-bounded-text-selection-retry.patch whitespace=-blank-at-eol,-space-before-tab,-blank-at-eof
